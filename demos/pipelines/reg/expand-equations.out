    r#" \qquad \triangleright \, z \\ "# c_at r#"\longrightarrow \; & "# c_at (("R_{i,c} = h_{i,c} + \\left(\\sum_{d=0}^{2} z_{i,d} \\, Wo_{d,c}\\right)"))
    c_at r#" \qquad \triangleright \, r \\ "# c_at r#"\longrightarrow \; & "#
    c_at (("Mean_{i} = \\frac{\\sum_{c=0}^{2} r_{i,c}}{3.0}")) c_at
    r#" \qquad \triangleright \, mu \\ "# c_at r#"\longrightarrow \; & "# c_at (("Var_{i} = \\frac{\\sum_{c=0}^{2} \\left(r_{i,c} - mu_{i}\\right)^{2}}{3.0}"))
    c_at r#" \qquad \triangleright \, var \\ "# c_at r#"\longrightarrow \; & "#
    c_at (("N_{i,c} = \\frac{g_{c} \\, \\left(r_{i,c} - mu_{i}\\right)}{\\sqrt{var_{i} + 0.00001}} + beta_{c}"))
    c_at r#" \qquad \triangleright \, y: n \times 3 \\ "# c_at
    r#"\longrightarrow \; & "# c_at (("F_{i,k} = \\left(\\sum_{c=0}^{2} y_{i,c} \\, W1_{c,k}\\right) + W1_{3,k}"))
    c_at r#" \qquad \triangleright \, f \\ "# c_at r#"\longrightarrow \; & "#
    c_at (("U_{i,k} = 0.7978845608028654 \\, \\left(f_{i,k} + 0.044715 \\, f_{i,k}^{3}\\right)"))

## LoRA: low-rank adapters: the adapted forward pass in factored form, the merge, the counts, the gradients and steps, LoRA-FA
##
## Import it with an alias of your choice: "lo:" u_se< "LoRA".
## Put libs/LoRA/src on XETAL_PATH ("just path"); the reference is libs/LoRA/docs.
## Names with l: are exported; h: names are private to this file.
##
## A frozen weight matrix W (m x n: m outputs, n inputs) is adapted by
## a low-rank update s B A: A is r x n, B is m x r, the rank r much
## smaller than m and n, s the scale alpha / r. An adapter is the tuple
## (W, A, B, s). The inputs are columns: x is one input of n numbers or
## an n x N matrix of N inputs, and W x is `W '+ '* i_nner x`. The
## forward pass keeps the factors apart, B (A x), as training does:
## the merged matrix W + s B A is made only to deploy it.
##
## Training moves A and B by the gradients of the squared error
## (g_rads, s_gd, a_dam through the Optim library); LoRA-FA freezes A
## (regenerated from a seed, s_eeded) and trains B alone; QLoRA keeps W
## in 4 bits (NF4, through the Quant library) and computes with it
## dequantized.

"op:" u_se< "Optim"
"qz:" u_se< "Quant"

### The forward pass

## `alpha s_caling r`: the adapter's scale s, alpha / r (so that a
## change of rank keeps the update's size).
## >> "lo:" u_se< "LoRA"
## >> 16.0 lo:s_caling 8
## 2.0
l:s_caling := { alpha r -> alpha / f_loat r }

## `alpha s_calingRs r`: rsLoRA's rank-stabilized scale, alpha / sqrt r
## (Kalajdzievski, "A Rank Stabilization Scaling Factor for Fine-Tuning
## with LoRA", 2023): with alpha / r the update's learning slows as r
## grows; over sqrt r it does not. An adapter takes either, (W, A, B, s).
## >> "lo:" u_se< "LoRA"
## >> 16.0 lo:s_calingRs 4
## 8.0
l:s_calingRs := { alpha r -> alpha / s_qrt f_loat r }

## `(W, A, B, s) f_orward x`: the adapted layer, W x + s B (A x), the
## update in its factored form: A x (r numbers per input), then B of
## that, never the m x n matrix B A.
## >> "lo:" u_se< "LoRA"
## >> (2 2 r_eshape 1.0 0.0 0.0 1.0, 1 2 r_eshape 1.0 1.0, 2 1 r_eshape 1.0 -1.0, 0.5) lo:f_orward 2.0 4.0
## 5.0 1.0
l:f_orward := { (W, A, B, s) x -> (W '+ '* i_nner x) + s * B '+ '* i_nner A '+ '* i_nner x }

### The merge

## `d_elta (A, B, s)`: the update itself, s B A, an m x n matrix of
## rank r at most.
## >> "lo:" u_se< "LoRA"
## >> lo:d_elta (1 2 r_eshape 1.0 1.0, 2 1 r_eshape 1.0 -1.0, 0.5)
##  0.5  0.5
## -0.5 -0.5
l:d_elta := { (A, B, s) -> s * B '+ '* i_nner A }

## `m_erge (W, A, B, s)`: the adapter folded into the weights, W + s B
## A: one matrix again, as fast as the base layer, for one task.
## >> "lo:" u_se< "LoRA"
## >> lo:m_erge (2 2 r_eshape 1.0 0.0 0.0 1.0, 1 2 r_eshape 1.0 1.0, 2 1 r_eshape 1.0 -1.0, 0.5)
##  1.5 0.5
## -0.5 0.5
l:m_erge := { (W, A, B, s) -> W + l:d_elta (A, B, s) }

### Gradients

## `(W, A, B, s) l_oss (x, y)`: the squared error of the adapted layer
## on the inputs x (columns) against the wanted outputs y, half the sum
## of the squared differences, so that its gradient at the output, g,
## is the difference itself.
## >> "lo:" u_se< "LoRA"
## >> (2 2 r_eshape 1.0 0.0 0.0 1.0, 1 2 r_eshape 1.0 1.0, 2 1 r_eshape 1.0 -1.0, 0.5) lo:l_oss (2 1 r_eshape 2.0 4.0, 2 1 r_eshape 4.0 2.0)
## 1.0
l:l_oss := { a (x, y) ->
  e := (a l:f_orward x) - y
  0.5 * '+ r_/ r_avel e * e
}

## `(W, A, B, s) g_rads (x, g)`: the gradients for the inputs x (an n x
## N matrix, one input per column) and g, the loss's gradient at the
## output (m x N): with z = A x, dL/dA = s (B' g) x', dL/dB = s g z' and
## dL/dx = W' g + s A' (B' g), as the tuple (dA, dB, dx). B' g is made
## once and used twice; no m x n matrix but W's own is made.
## >> "lo:" u_se< "LoRA"
## >> (dA, dB, dx) := (2 2 r_eshape 1.0 0.0 0.0 1.0, 1 2 r_eshape 1.0 1.0, 2 1 r_eshape 1.0 -1.0, 0.5) lo:g_rads (2 1 r_eshape 2.0 4.0, 2 1 r_eshape 1.0 -1.0)
## >> dB
##  3.0
## -3.0
l:g_rads := { (W, A, B, s) (x, g) ->
  b := (o_\ B) '+ '* i_nner g
  (s * b '+ '* i_nner o_\ x, s * g '+ '* i_nner o_\ A '+ '* i_nner x, ((o_\ W) '+ '* i_nner g) + s * (o_\ A) '+ '* i_nner b)
}

### Training steps

## `lr s_gd ((W, A, B, s), (x, y))`: one step of gradient descent on
## the squared error (l_oss) at the rate lr, A and B moved by Optim's
## s_gd, W and s left as they are: the adapter after the step. p_ower
## repeats it.
## >> "lo:" u_se< "LoRA"
## >> (_, A, B, _) := 0.1 lo:s_gd ((2 2 r_eshape 1.0 0.0 0.0 1.0, 1 2 r_eshape 1.0 1.0, 2 1 r_eshape 1.0 -1.0, 0.5), (2 1 r_eshape 2.0 4.0, 2 1 r_eshape 4.0 2.0))
## >> B
##  0.7
## -0.7
l:s_gd := { lr ((W, A, B, s), (x, y)) ->
  (dA, dB, _) := (W, A, B, s) l:g_rads (x, ((W, A, B, s) l:f_orward x) - y)
  (W, lr op:s_gd (A, dA), lr op:s_gd (B, dB), s)
}

## `a_damStart (W, A, B, s)`: what Adam starts from: the adapter, its
## four running averages at 0 (A's two, then B's) and the step count 1.
l:a_damStart := { (W, A, B, s) -> ((W, A, B, s), (0.0 * A, 0.0 * A, 0.0 * B, 0.0 * B), 1) }

## `lr a_dam (((W, A, B, s), (mA, vA, mB, vB), t), (x, y))`: Adam's step
## t on the squared error, A and B moved by Optim's a_dam at the rate
## lr; the next state, the step count one more.
## >> "lo:" u_se< "LoRA"
## >> ((_, _, B, _), _, _) := 0.1 lo:a_dam ((lo:a_damStart (2 2 r_eshape 1.0 0.0 0.0 1.0, 1 2 r_eshape 1.0 1.0, 2 1 r_eshape 1.0 -1.0, 0.5)), (2 1 r_eshape 2.0 4.0, 2 1 r_eshape 4.0 2.0))
## >> B
##  0.9000000003333333
## -0.9000000003333333
l:a_dam := { lr (((W, A, B, s), (mA, vA, mB, vB), t), (x, y)) ->
  (dA, dB, _) := (W, A, B, s) l:g_rads (x, ((W, A, B, s) l:f_orward x) - y)
  (A2, mA2, vA2) := (lr, t) op:a_dam (A, mA, vA, dA)
  (B2, mB2, vB2) := (lr, t) op:a_dam (B, mB, vB, dB)
  ((W, A2, B2, s), (mA2, vA2, mB2, vB2), t + 1)
}

### LoRA-FA: A frozen

## `seed s_eeded r n`: an r x n matrix regenerated from a whole-number
## seed (LoRA-FA's frozen A, which a checkpoint then need not hold):
## sin(seed k k) for k = 1 .. r n, over the square root of n (the
## inputs' count, so A x keeps x's size). No chance: the same seed
## gives the same matrix everywhere.
## >> "lo:" u_se< "LoRA"
## >> 7 lo:s_eeded 2 4
## 0.32849329935939453 0.13545289415393452  0.08367785015140346 -0.44499780218341667
## -0.4005672975890204  0.3115061055018265 -0.26829917759428185  0.47413628607807934
l:s_eeded := { seed rn ->
  k := f_loat r_ange '* r_/ rn
  rn r_eshape (s_in (f_loat seed) * k * k) / s_qrt f_loat 2 s_elect rn
}

## `(W, A, B, s) g_radsFA (x, g)`: LoRA-FA's gradients, (dB, dx): A is
## frozen, so its gradient is skipped, but x's still flows back through
## A, dx = W' g + s A' (B' g).
l:g_radsFA := { (W, A, B, s) (x, g) ->
  (s * g '+ '* i_nner o_\ A '+ '* i_nner x, ((o_\ W) '+ '* i_nner g) + s * (o_\ A) '+ '* i_nner (o_\ B) '+ '* i_nner g)
}

## `lr s_gdFA ((W, A, B, s), (x, y))`: LoRA-FA's step of gradient
## descent: B alone moves. Every update s B A it reaches has its rows
## in A's row space.
l:s_gdFA := { lr ((W, A, B, s), (x, y)) ->
  (dB, _) := (W, A, B, s) l:g_radsFA (x, ((W, A, B, s) l:f_orward x) - y)
  (W, A, lr op:s_gd (B, dB), s)
}

## `a_damStartFA (W, A, B, s)`: LoRA-FA's Adam state: the adapter, B's
## two running averages at 0 (A has none: half of LoRA's optimizer
## memory on a square layer), the step 1.
l:a_damStartFA := { (W, A, B, s) -> ((W, A, B, s), (0.0 * B, 0.0 * B), 1) }

## `lr a_damFA (((W, A, B, s), (mB, vB), t), (x, y))`: LoRA-FA's Adam
## step: B alone moves; the next state.
l:a_damFA := { lr (((W, A, B, s), (mB, vB), t), (x, y)) ->
  (dB, _) := (W, A, B, s) l:g_radsFA (x, ((W, A, B, s) l:f_orward x) - y)
  (B2, mB2, vB2) := (lr, t) op:a_dam (B, mB, vB, dB)
  ((W, A, B2, s), (mB2, vB2), t + 1)
}

### QLoRA: the base in 4 bits

## `k q_base W`: the base as QLoRA stores it: W in NF4, blocks of k
## (QLoRA's 64), as (codes, scales, shape): 4-bit codes, a scale per
## block, W's shape to come back to.
## >> "lo:" u_se< "LoRA"
## >> (q, s, sh) := 2 lo:q_base 2 2 r_eshape 1.0 -4.0 2.0 0.5
## >> s c_at f_loat sh
## 4.0 2.0 2.0 2.0
l:q_base := { k W ->
  (q, s) := k qz:n_f4Codes W
  (q, s, s_hape W)
}

## `d_equant (q, s, shape)`: the stored base back to numbers, W~, the
## matrix QLoRA computes with: each code's level times its block's
## scale, in W's shape. It is not W: the difference is the 4-bit
## error.
## >> "lo:" u_se< "LoRA"
## >> lo:d_equant 2 lo:q_base 2 2 r_eshape 1.0 -4.0 2.0 0.5
## 0.9844492077827454               -4.0
##                2.0 0.4922246038913727
l:d_equant := { (q, s, sh) -> sh r_eshape qz:n_f4Values (q, s) }

## `(Q, A, B, s) f_orwardQ x`: QLoRA's adapted layer, W~ x + s B (A x):
## the 4-bit base dequantized when the layer runs, the adapter in full
## precision. Its gradients and steps are LoRA's with W~ for W:
## `lr s_gd ((d_equant Q, A, B, s), (x, y))`.
l:f_orwardQ := { (Q, A, B, s) x -> (l:d_equant Q, A, B, s) l:f_orward x }

## `k m_ergeQ (Q, A, B, s)`: the adapter merged into a 4-bit base: W~ +
## s B A quantized again (blocks of k), as a stored base. Not exact:
## d_equant of it is not W~ + s B A, since the merged numbers fall
## between NF4's levels.
l:m_ergeQ := { k (Q, A, B, s) -> k l:q_base (l:d_equant Q) + l:d_elta (A, B, s) }

## `(r, k) q_bytes m n`: QLoRA's bytes for an m x n base at rank r,
## blocks of k: the base in NF4 (4 bits and a 32-bit scale per block),
## the adapter in BF16 (16 bits), Adam's two averages for it in FP32;
## against FP16's 2 m n for the base alone.
## >> "lo:" u_se< "LoRA"
## >> (16, 64) lo:q_bytes 4096 14336
## 33030144.0 589824.0 2359296.0
l:q_bytes := { (r, k) mn ->
  n := r l:p_arams mn
  ((f_loat '* r_/ mn) * (4.0 + 32.0 / f_loat k) / 8.0) c_at (16 l:b_ytes n) c_at 2.0 * 32 l:b_ytes n
}

### Rank

## One step of Gram-Schmidt on the rows: the k-th row's remainder R[k],
## if larger than tol, becomes a direction and is taken out of every
## row, and the count c goes up.
h:s_tep := { tol (R, k, c) ->
  v := k s_elect R
  n := s_qrt '+ r_/ v * v
  n <= tol ? (R, k + 1, c)
  (R - (R '+ '* i_nner v / n) '* t_able v / n, k + 1, c + 1)
}

## `r_ank M`: the number of independent rows of the matrix M (its
## rank), by Gram-Schmidt: a row counts when what is left of it, after
## the directions of the rows before it are taken out, is larger than
## 1e-9 times the largest row.
## >> "lo:" u_se< "LoRA"
## >> lo:r_ank 3 3 r_eshape 1.0 2.0 3.0 2.0 4.0 6.0 0.0 1.0 1.0
## 2
l:r_ank := { M ->
  tol := 0.000000001 * s_qrt 'm_ax r_/ '+ r_/_2 M * M
  (_, _, c) := (f_irst s_hape M) '{ R -> tol h:s_tep R } p_ower (M, 1, 0)
  c
}

### Counts

## `r p_arams m n`: the numbers an adapter of rank r on an m x n matrix
## trains, r (m + n) (B's m r and A's r n), against the m n of the
## matrix itself.
## >> "lo:" u_se< "LoRA"
## >> 16 lo:p_arams 4096 14336
## 294912
l:p_arams := { r mn -> r * '+ r_/ mn }

## `r e_xpert d f`: the numbers rank-r adapters train on one SwiGLU
## expert of hidden size d and inner size f: its three matrices (gate
## and up, f x d; down, d x f), 3 r (d + f).
## >> "lo:" u_se< "LoRA"
## >> 16 lo:e_xpert 4096 14336
## 884736
l:e_xpert := { r df -> 3 * r l:p_arams df }

## `r e_xpertFA d f`: the same expert under LoRA-FA: the numbers it
## trains (the B's, r (2f + d)), then the frozen A's it regenerates
## (r (2d + f)); together r e_xpert d f.
## >> "lo:" u_se< "LoRA"
## >> 16 lo:e_xpertFA 4096 14336
## 524288 360448
l:e_xpertFA := { r df ->
  (d, f) := (f_irst df, 2 s_elect df)
  (r * f + f + d) c_at r * d + d + f
}

## `b b_ytes n`: the bytes n numbers take at b bits each (16 for BF16
## and FP16, 32 for FP32, 4 for NF4).
## >> "lo:" u_se< "LoRA"
## >> 16 lo:b_ytes 884736
## 1769472.0
l:b_ytes := { b n -> (f_loat b * n) / 8.0 }

## `r c_osts m n`: the multiply-adds for one input through rank-r
## factors on an m x n matrix, B (A x) as r (m + n), then what making
## the matrix B A first costs, r m n.
## >> "lo:" u_se< "LoRA"
## >> 8 lo:c_osts 64 64
## 1024 32768
l:c_osts := { r mn -> (r l:p_arams mn) c_at r * '* r_/ mn }

#!/usr/bin/env xetal
# Flow: the five examples of X_eTaL's docs/spatial.md, each equal
# to its hand-written equivalent (X_eTaL's docs/spatial-poc/pipes-oracle.xtl),
# one-line and one stage per line (a raw string).
"flow:" u_se< "Flow"
"k:" u_se< "Check"
X := 2 3 r_eshape 1 2 3 4 5 6
W := 3 2 r_eshape 1 0 0 1 1 1
b := 10 20
z := f_loat 1 2 3
x := f_loat 1 2 3 4
W1 := 3 2 r_eshape 1 -1 0 1 -1 0
W2 := 2 1 r_eshape 1 2
# 1 linear regression
P := X '+ '* i_nner W
r1 := P + (s_hape P) r_eshape b
p1 := @ flow:p_ipe< "X |> it '+ '* i_nner W $P |> P + (s_hape P) r_eshape b"
p1
# 2 stable softmax
m := 'm_ax r_/ z
e := e_xp z - m
r2 := e / '+ r_/ e
p2 := @ flow:p_ipe< "z |> 'm_ax r_/ it $m |> e_xp z - m $e |> e / '+ r_/ e"
p2
# 3 layer norm (one vector, population variance, epsilon 0)
mu := ('+ r_/ x) / f_loat t_ally x
c := x - mu
v := ('+ r_/ c * c) / f_loat t_ally x
r3 := c / v ^ 0.5
p3 := @ flow:p_ipe< "x |> ('+ r_/ it) / f_loat t_ally it $mu |> x - mu $c |> ('+ r_/ c * c) / f_loat t_ally c $v |> c / v ^ 0.5"
p3
# 4 MLP
r4 := (0 m_ax X '+ '* i_nner W1) '+ '* i_nner W2
p4 := @ flow:p_ipe< "X |> it '+ '* i_nner W1 |> 0 m_ax it |> it '+ '* i_nner W2"
p4
# 5 residual (not 2 * x + x, which is 2 * (x + x) read right to left)
r5 := x + 2 * x
p5 := @ flow:p_ipe< "x $s |> 2 * it |> it + s"
p5
# The same five, one stage per line.
q1 := @ flow:p_ipe< r"
   X
|> it '+ '* i_nner W $P
|> P + (s_hape P) r_eshape b"
q2 := @ flow:p_ipe< r"
   z
|> 'm_ax r_/ it $m
|> e_xp z - m $e
|> e / '+ r_/ e"
q3 := @ flow:p_ipe< r"
   x
|> ('+ r_/ it) / f_loat t_ally it $mu
|> x - mu $c
|> ('+ r_/ c * c) / f_loat t_ally c $v
|> c / v ^ 0.5"
q4 := @ flow:p_ipe< r"
   X
|> it '+ '* i_nner W1
|> 0 m_ax it
|> it '+ '* i_nner W2"
q5 := @ flow:p_ipe< r"
   x $s
|> 2 * it
|> it + s"
c1 := "linear regression" k:t_est p1 k:i_s r1
c2 := "stable softmax" k:t_est p2 k:n_ear r2
c3 := "layer norm" k:t_est p3 k:n_ear r3
c4 := "MLP" k:t_est p4 k:i_s r4
c5 := "residual" k:t_est p5 k:n_ear r5
c6 := "one stage per line: the same (Int)" k:t_est ((r_avel q1) c_at r_avel q4) k:i_s (r_avel p1) c_at r_avel p4
c7 := "one stage per line: the same (Float)" k:t_est (q2 c_at q3 c_at q5) k:n_ear p2 c_at p3 c_at p5
k:r_eport c1 k:a_nd c2 k:a_nd c3 k:a_nd c4 k:a_nd c5 k:a_nd c6 k:a_nd c7

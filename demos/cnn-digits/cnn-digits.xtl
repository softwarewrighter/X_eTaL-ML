samples := (10 c_at 28 c_at 28) r_eshape samples
# -- end of the weights ---------------------------------------------

# -- the windows: nine shifted copies ------------------
# Item [a;b;r;c] is the pixel at row r + a - 2, column c + b - 2.
u:w_indows := { x -> -1 0 1 o_-_2 -1 0 1 o_-_2 x }
# -- convolution: 8 filters, the valid 26 x 26 ---------
# The windows with their edge rows and columns dropped (no wrap),
# as 9 x 676, times the filters as 8 x 9: one matrix product.
k9 := (8 c_at 9) r_eshape k
u:c_onv := { x ->
  v := 1 d_rop_4 -1 d_rop_4 1 d_rop_3 -1 d_rop_3 u:w_indows x
  y := k9 '+ '* i_nner (9 c_at 676) r_eshape v
  (8 c_at 26 c_at 26) r_eshape y + bc 'l_eft t_able o_ffsets 676
}
u:r_elu := { x -> 0.0 m_ax x }
# -- pooling: the largest of each 2 x 2 block ----------
u:p_ool := { x -> 'm_ax r_/_3 'm_ax r_/_5 (8 c_at 13 c_at 2 c_at 13 c_at 2) r_eshape x }
# -- dense: 1352 pooled values to 10 -------------------
u:d_ense := { h -> bd + r_avel ((1 c_at 1352) r_eshape r_avel h) '+ '* i_nner w }
# -- softmax: the ten scores as probabilities ----------
u:s_oftmax := { z ->
  e := e_xp z - 'm_ax r_/ z
  e / '+ r_/ e
}
u:c_lassify := { x -> u:s_oftmax u:d_ense u:p_ool u:r_elu u:c_onv x }
# The digit with the largest probability.
u:a_rgmax := { p -> '+ r_/ (f_loat p = 'm_ax r_/ p) * f_loat o_ffsets 10 }
# -- end of the core -----------------------------------

# The test digit 7, drawn darkest to brightest.
x := 8 s_elect samples
s_hape x
(1 + f_loor 0 m_ax 7 m_in 8.0 * x) s_elect " .:-=+*#"
# The stages' shapes.
(s_hape u:c_onv x) c_at (s_hape u:p_ool u:r_elu u:c_onv x) c_at s_hape u:d_ense u:p_ool u:r_elu u:c_onv x
# Its ten probabilities, rounded.
(f_loat f_loor 0.5 + 1000.0 * u:c_lassify x) / 1000.0
# What the network reads in each of the ten test digits (0 to 9).
u:g_uess := { i -> u:a_rgmax u:c_lassify i s_elect samples }
(u:g_uess 1) c_at (u:g_uess 2) c_at (u:g_uess 3) c_at (u:g_uess 4) c_at (u:g_uess 5) c_at (u:g_uess 6) c_at (u:g_uess 7) c_at (u:g_uess 8) c_at (u:g_uess 9) c_at u:g_uess 10

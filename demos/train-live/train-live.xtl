#!/usr/bin/env xetal
## Training in X_eTaL: a network (2 inputs, 16 tanh units, softmax over
## 3) learns which of three spiral arms a point is on. The points are
## made here; the backward pass is the backprop microscope's; Adam,
## written out, moves the weights; p_ower repeats the step.

"nn:" u_se< "NN"

### The spiral: 100 points on each of three arms
n := 300
i := o_ffsets n
arm := i d_iv 100
t := (0.5 + f_loat i m_od 100) / 100.0
a := (2.0944 * f_loat arm) + (5.5 * t) + 0.1 * (f_loat (r_oll! n r_eshape 1001) - 501) / 500.0
X := o_\ (2 c_at n) r_eshape ((0.1 + 0.9 * t) * c_os a) c_at (0.1 + 0.9 * t) * s_in a
Y := 3 nn:o_neHot 1 + arm

### The network: W1 (3 x 16), W2 (17 x 3), each bias its last row
u:o_nes := { x -> x c_at_2 ((t_ally x) c_at 1) r_eshape 1.0 }
u:f_orward := { W1 W2 -> nn:s_oftmax (nn:t_anh X nn:d_ense W1) nn:d_ense W2 }
## The gradients of the loss by W1 and by W2, a pair (the backprop
## microscope's four lines).
u:g_rad := { W1 W2 ->
  H := nn:t_anh X nn:d_ense W1
  D2 := ((nn:s_oftmax H nn:d_ense W2) - Y) / f_loat n
  D1 := (D2 '+ '* i_nner o_\ -1 d_rop W2) * 1.0 - H * H
  ((o_\ u:o_nes X) '+ '* i_nner D1, (o_\ u:o_nes H) '+ '* i_nner D2)
}
### Adam
# The state is a tuple, (W1, W2, M1, M2, V1, V2, k): the weights, the
# running averages of gradients and of their squares, the step count;
# p_ower iterates it as one value.
## The learning rate.
lr := 0.02
## How far Adam moves a weight array, from its averages (m, v) at step k.
u:m_ove := { (m, v) k -> (m / 1.0 - 0.9 ^ k) / 0.00000001 + (v / 1.0 - 0.999 ^ k) ^ 0.5 }
## One step of Adam.
u:a_dam := { (W1, W2, M1, M2, V1, V2, k) ->
  k := 1.0 + k
  (G1, G2) := W1 u:g_rad W2
  M1 := (0.9 * M1) + 0.1 * G1
  M2 := (0.9 * M2) + 0.1 * G2
  V1 := (0.999 * V1) + 0.001 * G1 * G1
  V2 := (0.999 * V2) + 0.001 * G2 * G2
  (W1 - lr * (M1, V1) u:m_ove k, W2 - lr * (M2, V2) u:m_ove k, M1, M2, V1, V2, k)
}
## The starting state: small random weights, zero averages, step 0.
w0 := (f_loat (r_oll! 99 r_eshape 2001) - 1001) / 1000.0
W1 := 3 16 r_eshape 48 t_ake w0
W2 := 17 3 r_eshape 48 d_rop w0
s0 := (W1, W2, 0.0 * W1, 0.0 * W2, 0.0 * W1, 0.0 * W2, 0.0)
# -- end of the core ------------------------------------------

## The loss, and the share of points right, of a state.
u:l_oss := { (W1, W2, _, _, _, _, _) -> Y nn:c_rossEntropy W1 u:f_orward W2 }
u:r_ight := { (W1, W2, _, _, _, _, _) -> (1 + arm) nn:a_ccuracy W1 u:f_orward W2 }
## The loss and the share of points right: before, after 100 steps,
## after 400.
s1 := 100 'u:a_dam p_ower s0
s2 := 300 'u:a_dam p_ower s1
u:r_ound := { a -> (f_loat f_loor 0.5 + 1000.0 * a) / 1000.0 }
u:r_ound (u:l_oss s0) c_at (u:l_oss s1) c_at u:l_oss s2
u:r_ound (u:r_ight s0) c_at (u:r_ight s1) c_at u:r_ight s2

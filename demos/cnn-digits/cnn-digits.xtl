#!/usr/bin/env xetal
## A tiny convolutional network reads a handwritten digit: 28 x 28 ->
## 8 filters of 3 x 3 -> ReLU -> 2 x 2 max-pooling -> dense -> softmax.
## The convolution is the picture's nine shifted copies times the
## filters: one matrix product. Trained offline on MNIST (97.82% of
## the 10,000 test digits right); just cnn-train writes data/.

"nn:" u_se< "NN"

### The network, read from data/
fb := 8 10 r_eshape n_umbers []N_GET "data/filters.txt"
k9 := 9 t_ake_2 fb                      # 8 filters, 3 x 3 each as 9
bc := r_avel -1 t_ake_2 fb              # their biases
wb := 1353 10 r_eshape n_umbers []N_GET "data/dense.txt"
samples := 10 28 28 r_eshape n_umbers []N_GET "data/samples.txt"

### The core: every stage one array expression
u:c_onv := { x ->
  v := 1 d_rop_4 -1 d_rop_4 1 d_rop_3 -1 d_rop_3 -1 0 1 o_-_2 -1 0 1 o_-_2 x
  8 26 26 r_eshape (k9 '+ '* i_nner 9 676 r_eshape v) + bc 'l_eft t_able o_ffsets 676
}
u:p_ool := { x -> 'm_ax r_/_35 8 13 2 13 2 r_eshape x }
u:c_lassify := { x -> f_irst nn:s_oftmax (1 1352 r_eshape r_avel u:p_ool nn:r_elu u:c_onv x) nn:d_ense wb }
# -- end of the core -------------------------------------

### Drawing: values as shades, maps side by side
u:s_hade := { m -> (1 + f_loor 0 m_ax 7 m_in 8.0 * m) s_elect " .:-=+*#" }
## Each of n maps scaled from its own smallest to largest value, then shaded.
u:m_aps := { m ->
  n := 1 t_ake s_hape m
  e := '* r_/ 1 d_rop s_hape m
  f := (n c_at e) r_eshape m
  lo := (n c_at e) r_eshape (n r_eshape e) r_eplicate 'm_in r_/_2 f
  hi := (n c_at e) r_eshape (n r_eshape e) r_eplicate 'm_ax r_/_2 f
  u:s_hade (s_hape m) r_eshape (f - lo) / 0.000001 m_ax hi - lo
}
u:w_ide := { c -> ((-1 t_ake s_hape c) r_eshape 2) r_eplicate_2 c }
u:s_ide := { c ->
  g := c c_at_3 ((2 t_ake s_hape c) c_at 2) r_eshape " "
  ((1 s_elect 1 d_rop s_hape g) c_at '* r_/ 1 0 1 r_eplicate s_hape g) r_eshape 2 1 3 t_ranspose g
}

## A test digit: a 7.
x := 8 s_elect samples
u:w_ide 28 28 r_eshape u:s_hade x
# The 8 filters (3 x 3), from most negative to most positive.
u:s_ide (1 + f_loor 0 m_ax 4 m_in 2.5 + 2.0 * 8 3 3 r_eshape k9) s_elect "=-.+#"
## Convolution and ReLU: 8 maps of 26 x 26, what each filter finds.
c := nn:r_elu u:c_onv x
u:s_ide u:m_aps 4 t_ake c
u:s_ide u:m_aps 4 d_rop c
## Max-pooling: 8 maps of 13 x 13 (drawn twice as wide).
m := u:p_ool c
u:w_ide u:s_ide u:m_aps 4 t_ake m
u:w_ide u:s_ide u:m_aps 4 d_rop m
## The ten probabilities, as bars: the network reads a 7.
p := u:c_lassify x
u:b_ars := { p -> (1 + (f_loor 0.5 + 50.0 * p) '> t_able o_ffsets 50) s_elect " #" }
(10 1 r_eshape []D) c_at_2 (10 2 r_eshape " ") c_at_2 u:b_ars p
f_loor 0.5 + 100.0 * p
## The ten test digits (0 to 9): what the network reads, how sure (%).
u:r_ead := { i -> (nn:a_rgmax u:c_lassify i s_elect samples) - 1 }
u:s_ure := { i -> f_loor 0.5 + 100.0 * 'm_ax r_/ u:c_lassify i s_elect samples }
'u:r_ead e_ach r_ange 10
'u:s_ure e_ach r_ange 10
## The same probabilities as the trainer's Rust forward pass, for all ten?
expected := 10 10 r_eshape n_umbers []N_GET "data/expected.txt"
u:g_ap := { i -> 'm_ax r_/ a_bs (u:c_lassify i s_elect samples) - i s_elect expected }
1e-9 > 'm_ax r_/ 'u:g_ap e_ach r_ange 10

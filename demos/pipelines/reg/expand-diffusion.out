#!/usr/bin/env xetal
## Diffusion sampling four ways, a second Rosetta Stone: the two
## equations of a latent diffusion sampler as a paper prints them, read
## by X_eTaL-libraries' Equations; the sampler as a pipeline (Flow);
## and in plain X_eTaL, as this repository's diffusion demo runs it.
## The pipeline's expansion, the fourth way, is what `xetal expand
## diffusion.xtl` shows. All give the same pictures.
##
## The paper's two forms (bold z a latent, D the decoder, eps_theta the
## denoiser conditioned on the text embedding of the prompt):
##   X0 = D(zT + sum_{t=T}^{1} [a_t z_t + b_t eps_theta(z_t, t, E_text(prompt)) + sigma_t eps_rand] - z_t)
##   X0 = D(z0) = D(zT + sum_{t=1}^{T} dz_t)
## The first sum is a recurrence (its term at t uses the z_t the term
## before made), so it is one step as the paper's summand, applied T
## times; the second is a plain sum of the steps' differences, and
## telescopes to the same z0.

"e:" u_se< "Equations"
"flow:" u_se< "Flow"
"nn:" u_se< "NN"
"k:" u_se< "Check"

### Data

## A batch of N latents of K numbers, T steps; the schedule a_t, b_t
## and sigma_t (the last step takes no noise, as DDIM), and the noise
## eps_rand of every step, drawn once (a formula stands in for a
## Gaussian draw, so the run is the same everywhere).
N := 2
K := 4
T := 3
a := 0.9 0.8 0.7
b := 0.1 0.2 0.3
sigma := 0.05 0.05 0.0
noise := (T c_at N c_at K) r_eshape 0.5 * c_os f_loat r_ange 24
zT := (N c_at K) r_eshape s_in f_loat r_ange 8

## The networks, stand-ins with made-up weights (the diffusion demo
## trains real ones): the text encoder gives the prompt's embedding c;
## the denoiser is a dense layer over each latent joined with its level
## and c; the decoder a dense layer over the latent.
c := 0.5 -0.5
We := 8 4 r_eshape 0.3 * s_in f_loat r_ange 32
Wd := 5 4 r_eshape 0.3 * c_os f_loat r_ange 20
u:e_psTheta := { (Z, t) -> (Z c_at_2 (N c_at 3) r_eshape (f_loat t) c_at c) nn:d_ense We }

### As a paper prints it

## One step of the first sum, the paper's summand at level t: a_t z_t
## + b_t eps_theta(z_t, t, c) + sigma_t eps_rand, read by Equations
## over the batch (n) and the latent (k); the level goes down one.
u:s_tep := { (Z, t) ->
  eps := u:e_psTheta (Z, t)
  Zn := (({ @ ->
  g3:a_t := { A i -> (1 + i) s_elect r_avel A }
  g2:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g1:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  g4:grid := N c_at K
  g5:g_rid := { k ->
    g4:grid r_eshape (o_ffsets k s_elect g4:grid) 'l_eft t_able ('* r_/ k d_rop g4:grid) r_eshape 0
  }
  g4:grid r_eshape (({ @ ->
    g6:grid := N c_at K
    g7:g_rid := { k ->
      g6:grid r_eshape (o_ffsets k s_elect g6:grid) 'l_eft t_able ('* r_/ k d_rop g6:grid) r_eshape 0
    }
    g6:grid r_eshape ((((
    ((g1:r_ank (a, "a", 1, "a[t-1]")) g3:a_t (
      ((a, "a", 1, "t-1") g2:c_heck (t - 1)))) * 
    ((g1:r_ank (Z, "Z", 2, "Z[n,k]")) g3:a_t ((
      ((Z, "Z", 2, "k") g2:c_heck (0 + g7:g_rid 2)) + (2 s_elect s_hape Z) * 
      ((Z, "Z", 1, "n") g2:c_heck (0 + g7:g_rid 1)))))) + (
    ((g1:r_ank (b, "b", 1, "b[t-1]")) g3:a_t (
      ((b, "b", 1, "t-1") g2:c_heck (t - 1)))) * 
    ((g1:r_ank (eps, "eps", 2, "eps[n,k]")) g3:a_t ((
      ((eps, "eps", 2, "k") g2:c_heck (0 + g7:g_rid 2)) + (2 s_elect s_hape eps)
                  * 
      ((eps, "eps", 1, "n") g2:c_heck (0 + g7:g_rid 1))))))) + (
    ((g1:r_ank (sigma, "sigma", 1, "sigma[t-1]")) g3:a_t (
      ((sigma, "sigma", 1, "t-1") g2:c_heck (t - 1)))) * 
    ((g1:r_ank (noise, "noise", 3, "noise[t-1,n,k]")) g3:a_t ((
      ((noise, "noise", 3, "k") g2:c_heck (0 + g7:g_rid 2)) + (3 s_elect s_hape noise)
                * (
      ((noise, "noise", 2, "n") g2:c_heck (0 + g7:g_rid 1)) + (2 s_elect s_hape noise)
                  * 
      ((noise, "noise", 1, "t-1") g2:c_heck (t - 1)))))))))
  } @))
} @))
  (Zn, t - 1)
}
"Zn_{n,k} = a_{t-1} \\, Z_{n,k} + b_{t-1} \\, eps_{n,k} + sigma_{t-1} \\, noise_{t-1,n,k}"

## The steps' differences dz_t = z_{t-1} - z_t, a row of N x K per
## step, collected as the T steps run; then the second form, the sum
## of them, and the decoder.
u:c_ollect := { (Z, t, dz) ->
  (Zn, tn) := u:s_tep (Z, t)
  (Zn, tn, dz c_at (1 c_at N c_at K) r_eshape Zn - Z)
}
(_, _, dz) := T 'u:c_ollect p_ower (zT, T, (0 c_at N c_at K) r_eshape 0.0)
eq := ((({ @ ->
  g10:a_t := { A i -> (1 + i) s_elect r_avel A }
  g9:c_heck := { (A, name, k, from) e ->
    n := k s_elect s_hape A
    bad := w_here n_ot r_avel (0 <= e) & e < n
    0 = t_ally bad ? e
    "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
  }
  g8:r_ank := { (A, name, q, ref) ->
    (t_ally s_hape A) = q ? A
    "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
  }
  g11:grid := N c_at K
  g12:g_rid := { k ->
    g11:grid r_eshape (o_ffsets k s_elect g11:grid) 'l_eft t_able ('* r_/ k d_rop g11:grid) r_eshape 0
  }
  g11:grid r_eshape ((
    ((g8:r_ank (zT, "zT", 2, "zT[n,k]")) g10:a_t ((
      ((zT, "zT", 2, "k") g9:c_heck (0 + g12:g_rid 2)) + (2 s_elect s_hape zT) *
            
      ((zT, "zT", 1, "n") g9:c_heck (0 + g12:g_rid 1))))) + ({ @ ->
    g13:grid := N c_at K c_at ({ v ->
      (0 <= v) ? v
      "bad-equation" []S_IGNAL "sum's range runs low..high: 1..T"
    } (1 + T - 1))
    g14:g_rid := { k ->
      g13:grid r_eshape (o_ffsets k s_elect g13:grid) 'l_eft t_able ('* r_/ k d_rop g13:grid) r_eshape 0
    }
    '+ r_/_3 g13:grid r_eshape (
    ((g8:r_ank (dz, "dz", 3, "dz[t-1,n,k]")) g10:a_t ((
      ((dz, "dz", 3, "k") g9:c_heck (0 + g14:g_rid 2)) + (3 s_elect s_hape dz) *
            (
      ((dz, "dz", 2, "n") g9:c_heck (0 + g14:g_rid 1)) + (2 s_elect s_hape dz) *
              
      ((dz, "dz", 1, "t-1") g9:c_heck ((1 + g14:g_rid 3) - 1)))))))
  } @)))
} @))) nn:d_ense Wd
"z0_{n,k} = zT_{n,k} + \\left(\\sum_{t=1}^{T} dz_{t-1,n,k}\\right)"

## The second form as a pipeline of equations: the latents of noise,
## the steps' differences added, the decoder (a dense layer, its bias
## Wd's last row); drawn as math a row a stage.
eqpipe := ({ @ ->
  g15:stage := zT
  z0 := { @ ->
    it := g15:stage
    ({ @ ->
      g19:a_t := { A i -> (1 + i) s_elect r_avel A }
      g18:c_heck := { (A, name, k, from) e ->
        n := k s_elect s_hape A
        bad := w_here n_ot r_avel (0 <= e) & e < n
        0 = t_ally bad ? e
        "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
      }
      g17:r_ank := { (A, name, q, ref) ->
        (t_ally s_hape A) = q ? A
        "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
      }
      g20:grid := N c_at K
      g21:g_rid := { k ->
        g20:grid r_eshape (o_ffsets k s_elect g20:grid) 'l_eft t_able ('* r_/ k d_rop g20:grid) r_eshape 0
      }
      g20:grid r_eshape ((
    ((g17:r_ank (it, "it", 2, "it[n,k]")) g19:a_t ((
      ((it, "it", 2, "k") g18:c_heck (0 + g21:g_rid 2)) + (2 s_elect s_hape it)
            * 
      ((it, "it", 1, "n") g18:c_heck (0 + g21:g_rid 1))))) + ({ @ ->
        g22:grid := N c_at K c_at ({ v ->
      (0 <= v) ? v
      "bad-equation" []S_IGNAL "sum's range runs low..high: 1..T"
    } (1 + T - 1))
        g23:g_rid := { k ->
          g22:grid r_eshape (o_ffsets k s_elect g22:grid) 'l_eft t_able ('* r_/ k d_rop g22:grid) r_eshape 0
        }
        '+ r_/_3 g22:grid r_eshape (
    ((g17:r_ank (dz, "dz", 3, "dz[t-1,n,k]")) g19:a_t ((
      ((dz, "dz", 3, "k") g18:c_heck (0 + g23:g_rid 2)) + (3 s_elect s_hape dz)
            * (
      ((dz, "dz", 2, "n") g18:c_heck (0 + g23:g_rid 1)) + (2 s_elect s_hape dz)
              * 
      ((dz, "dz", 1, "t-1") g18:c_heck ((1 + g23:g_rid 3) - 1)))))))
      } @)))
    } @)
  } @
  g16:stage := (({ @ ->
    g26:a_t := { A i -> (1 + i) s_elect r_avel A }
    g25:c_heck := { (A, name, k, from) e ->
      n := k s_elect s_hape A
      bad := w_here n_ot r_avel (0 <= e) & e < n
      0 = t_ally bad ? e
      "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
    }
    g24:r_ank := { (A, name, q, ref) ->
      (t_ally s_hape A) = q ? A
      "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
    }
    g27:grid := N c_at K
    g28:g_rid := { k ->
      g27:grid r_eshape (o_ffsets k s_elect g27:grid) 'l_eft t_able ('* r_/ k d_rop g27:grid) r_eshape 0
    }
    g27:grid r_eshape ((({ @ ->
      g29:grid := N c_at K c_at ({ v ->
      (0 <= v) ? v
      "bad-equation" []S_IGNAL "sum's range runs low..high: 0..K-1"
    } (1 + (K - 1) - 0))
      g30:g_rid := { k ->
        g29:grid r_eshape (o_ffsets k s_elect g29:grid) 'l_eft t_able ('* r_/ k d_rop g29:grid) r_eshape 0
      }
      '+ r_/_3 g29:grid r_eshape ((
    ((g24:r_ank (z0, "z0", 2, "z0[n,k]")) g26:a_t ((
      ((z0, "z0", 2, "k") g25:c_heck (0 + g30:g_rid 3)) + (2 s_elect s_hape z0)
              * 
      ((z0, "z0", 1, "n") g25:c_heck (0 + g30:g_rid 1))))) * 
    ((g24:r_ank (Wd, "Wd", 2, "Wd[k,j]")) g26:a_t ((
      ((Wd, "Wd", 2, "j") g25:c_heck (0 + g30:g_rid 2)) + (2 s_elect s_hape Wd)
              * 
      ((Wd, "Wd", 1, "k") g25:c_heck (0 + g30:g_rid 3)))))))
    } @) + 
    ((g24:r_ank (Wd, "Wd", 2, "Wd[K,j]")) g26:a_t ((
      ((Wd, "Wd", 2, "j") g25:c_heck (0 + g28:g_rid 2)) + (2 s_elect s_hape Wd)
            * 
      ((Wd, "Wd", 1, "K") g25:c_heck K))))))
  } @))
  g16:stage
} @)
drawn := ((r#"\begin{aligned} "# c_at r#"& "# c_at r#"zT"# c_at r#" \\ "# c_at
    r#"\longrightarrow \; & "# c_at (("Z0_{n,k} = zT_{n,k} + \\left(\\sum_{t=1}^{T} dz_{t-1,n,k}\\right)"))
    c_at r#" \qquad \triangleright \, z0 \\ "# c_at r#"\longrightarrow \; & "#
    c_at (("X0_{n,j} = \\left(\\sum_{k=0}^{K - 1} z0_{n,k} \\, Wd_{k,j}\\right) + Wd_{K,j}"))
    c_at r#""# c_at r#" \end{aligned}"#))
drawn

### As a pipeline

## The latents of noise, the T steps (p_ower applies the step T times
## to the latents and the level), the final latents labeled, the decoder.
pipe := ({ @ ->
  g31:stage := zT
  (z0, t0) := { @ ->
    it := g31:stage
    T 'u:s_tep p_ower (it, T)
  } @
  X0 := z0 nn:d_ense Wd
  _ := { @ ->
    ((s_hape X0) m_atch r_avel N c_at K) ? @
    "shape" []S_IGNAL "stage 3 (X0): shape " c_at (f_ormat s_hape X0) c_at ", expected " c_at f_ormat r_avel N c_at K
  } @
  X0
} @)

### Plain X_eTaL

## The step without the macro: the schedule's values by level, the
## noise's slab; then the sampler as the diffusion demo writes it.
u:p_lain := { (Z, t) -> (((t s_elect a) * Z) + ((t s_elect b) * u:e_psTheta (Z, t)) + (t s_elect sigma) * t s_elect noise, t - 1) }
(zp, _) := T 'u:p_lain p_ower (zT, T)
plain := zp nn:d_ense Wd

### The same

r0 := "the equations and the pipeline of equations" k:t_est eq k:n_ear eqpipe
r1 := "the equations and the pipeline" k:t_est eq k:n_ear pipe
r2 := "the pipeline and plain X_eTaL" k:t_est pipe k:n_ear plain
k:r_eport r0 k:a_nd r1 k:a_nd r2

## The decoded pictures, a row per latent.
plain


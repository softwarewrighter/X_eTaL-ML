## Flow: ML data flow written left to right, |> between stages -- each stage becomes one line of X_eTaL
##
## Import it with an alias of your choice: "flow:" u_se< "Flow" (flow:p_ipe<).
## Put libs/Flow/src on XETAL_PATH ("just path"); the reference is libs/Flow/docs.
## Names with m: are macros; those under h: are private to this file.
##
## A macro is a function from the source text written left and right of
## its call to the source that replaces the call, before the program is
## compiled (X_eTaL MC10); xetal expand FILE shows the result. The
## pipeline was decided in X_eTaL (D155, its docs/spatial.md,
## "Pipelines") and is built here (docs/pipeline-macro.md). Its reader
## uses all of its text or refuses it: a stage the grammar does not
## know is a compile-time error naming the text, never a wrong answer.

"t:" u_se< "Strings"

### The macros

## The value of a pipeline: the data, then each stage in turn, |>
## between them. A stage is a function (nn:r_elu, [f_ g_], '{ x -> ... }),
## applied to the previous value, or an expression naming the previous
## value it (W nn:d_ense it; the order is written, never guessed).
## "$name" at a stage's end names its value for the later stages, the
## $ touching the name ("$(Q, K, V)" takes a tuple apart, as X_eTaL's
## S14 label is written and drawn); " [N O]" after the name is the
## shape the value must have, checked when the program runs
## (error[shape], naming the stage, its shape and the one expected).
## The left side is @; the right is a code string c"...", drawn as
## X_eTaL (|> and $ as triangles), and may put one stage per line; a
## plain or raw string reads the same.
## binds: it
## uses: parsed
## >> "flow:" u_se< "Flow"
## >> x := f_loat 1 2 3 4
## >> @ flow:p_ipe< c"x $s |> 2 * it |> it + s"
## 3.0 6.0 9.0 12.0
m:p_ipe< := { @ text -> h:w_rite h:r_ead text }

## The pipeline written back from its reading, a string: the stages
## trimmed, " |> " between them, each name and shape as written. What
## the macro read is what was written, or the call was refused.
## uses: parsed
## >> "flow:" u_se< "Flow"
## >> @ flow:t_ext< c"x   $s |>  2 * it   |> it + s"
## x $s |> 2 * it |> it + s
m:t_ext< := { @ text -> "\"" c_at (h:e_scape h:s_how h:r_ead text) c_at "\"" }

### Reading the call

## The stages of text as (expressions, names, shapes), each a boxed
## text per stage ("" for no name or no shape), every rule checked.
h:r_ead := { text ->
  t := t:t_rim text
  _ := (0 < t_ally t) h:r_equire "an empty pipeline: write the data, then |> and each stage"
  parts := '{ p -> t:t_rim d_isclose p } m_ap "|>" h:s_plit t
  _ := '{ p -> h:t_ouches? d_isclose p } m_ap parts
  _ := ('& r_/ '{ p -> 0 < t_ally d_isclose p } e_ach parts) h:r_equire "an empty stage (nothing between two |>, or after the last): " c_at t
  es := '{ p -> h:e_xpr d_isclose p } m_ap parts
  bs := '{ p -> h:b_inder d_isclose p } m_ap parts
  ss := '{ p -> h:s_hapeOf d_isclose p } m_ap parts
  _ := '{ i -> (h:f_latten (i - 1) t_ake bs) h:s_tage? d_isclose i s_elect es } m_ap 1 d_rop r_ange t_ally es
  _ := (n_ot h:i_t? d_isclose f_irst es) h:r_equire "the first stage is the data; nothing precedes it: " c_at d_isclose f_irst es
  _ := '{ b -> h:b_inder? d_isclose b } m_ap bs
  _ := (ss, bs) h:s_hapes? r_ange t_ally ss
  all := h:f_latten bs
  twice := (1 < '+ r_/_2 0 + all 'm_atch t_able all) r_eplicate all
  _ := (0 = t_ally twice) h:r_equire "a name is bound once in a pipeline: " c_at h:f_irstText twice
  (es, bs, ss)
}

## A stage's expression: its text before its label's $, trimmed.
h:e_xpr := { s ->
  c := h:l_abel s
  0 = c ? t:t_rim s
  t:t_rim (c - 1) t_ake s
}

## What follows a stage's $, trimmed ("" for no label).
h:a_fter := { s ->
  c := h:l_abel s
  0 = c ? ""
  t:t_rim c d_rop s
}

## A stage's name (or tuple of names): the text after $ up to its
## shape's [, trimmed; "" for none.
h:b_inder := { s ->
  a := h:a_fter s
  k := "[" h:f_irstOf a
  0 = k ? a
  t:t_rim (k - 1) t_ake a
}

## A stage's shape as written, "[N O]", from its first [ on; "" for none.
h:s_hapeOf := { s ->
  a := h:a_fter s
  k := "[" h:f_irstOf a
  0 = k ? ""
  t:t_rim (k - 1) d_rop a
}

## Where the first $ outside brackets and strings is in s, or 0.
h:l_abel := { s -> h:f_irst "$" h:o_utside s }

## A stage's $ touches the name or tuple it gives ($m, $(Q, K)), as
## X_eTaL's own label does: $ m, or a $ with nothing after it, is
## refused ("" when the stage has no label or its $ touches).
h:t_ouches? := { s ->
  c := h:l_abel s
  0 = c ? ""
  msg := "$ labels a stage and touches the name or tuple it gives ($m, $(Q, K)): " c_at s
  c = t_ally s ? (0 = 1) h:r_equire msg
  (((c + 1) s_elect s) m_ember? letters c_at "(") h:r_equire msg
}

## A stage after the first is a function, or an expression naming the
## previous value it or a name bound before it (earlier, boxed); else
## the call is refused with the text ("" when it is one of these).
h:s_tage? := { earlier e ->
  named := '| r_/ (0 = 1) c_at '{ w -> (d_isclose w) h:w_ord? e } e_ach earlier
  ((h:i_t? e) | (h:f_unction? e) | named) h:r_equire "a stage is a function (nn:r_elu, [f_ g_], '{ x -> ... }) or an expression naming the previous value it (or a name bound before it): " c_at e
}

## Whether e names the previous value: the word it, outside strings.
h:i_t? := { e -> "it" h:w_ord? e }

## Whether the word w (a name) occurs whole in e, outside strings.
h:w_ord? := { w e ->
  ps := w t:f_ind e
  0 = t_ally ps ? 0 = 1
  q := h:q_uoted e
  n := t_ally w
  before := '{ p -> p = 1 ? 0 = 1; ((p - 1) s_elect e) m_ember? nameChars } e_ach ps
  after := '{ p -> (p + n) > t_ally e ? 0 = 1; ((p + n) s_elect e) m_ember? nameChars } e_ach ps
  '| r_/ (n_ot before) & (n_ot after) & 0 = ps s_elect q
}

## Whether e is written as a function: a quoted function or lambda
## ('n_eg, '+ r_/, '{ x -> ... }), a train ([f_ g_]), or one function
## name (nn:r_elu, t_ally: no blanks, an underline).
h:f_unction? := { e ->
  ("'" m_atch 1 t_ake e) | "[" m_atch 1 t_ake e ? 0 = 0
  (0 = t_ally w_here e m_ember? " ") & (0 < t_ally w_here e m_ember? "_") & '& r_/ e m_ember? nameChars
}

## A name after $ is a plain name (letters and digits, a letter
## first) or a tuple of two or more, (Q, K, V); never it; else refused
## ("" when it is).
h:b_inder? := { b ->
  0 = t_ally b ? ""
  _ := (n_ot "it" m_atch b) h:r_equire "it is the previous value, not a name to bind: " c_at b
  ps := h:p_arts b
  allNames := '& r_/ '{ p -> h:n_ame? d_isclose p } e_ach ps
  tuple := ("(" m_atch 1 t_ake b) & (")" m_atch -1 t_ake b) & 2 <= t_ally ps
  (allNames & (tuple | n_ot "(" m_atch 1 t_ake b)) h:r_equire "after $ comes a plain name, or a tuple of names (Q, K, V): " c_at b
}

## The names a binder binds, boxed: the name itself, or a tuple's parts.
h:p_arts := { b ->
  n_ot "(" m_atch 1 t_ake b ? 1 r_eshape e_nclose b
  '{ p -> t:t_rim d_isclose p } m_ap "," t:s_plit 1 d_rop -1 d_rop b
}

## Every name the stages bind, boxed, in order.
h:f_latten := { bs ->
  0 = t_ally bs ? 0 r_eshape e_nclose ""
  0 = t_ally d_isclose f_irst bs ? h:f_latten 1 d_rop bs
  (h:p_arts d_isclose f_irst bs) c_at h:f_latten 1 d_rop bs
}

## Whether b is a plain name: a letter, then letters or digits.
h:n_ame? := { b ->
  0 = t_ally b ? 0 = 1
  ((f_irst b) m_ember? letters) & '& r_/ b m_ember? plainChars
}

## The shapes against their names, each stage: a shape needs a single
## name before it, is [extents] whole (names or numbers, blanks
## between) and nothing follows it; else refused with the text ("" each).
h:s_hapes? := { (ss, bs) is ->
  '{ i ->
    sh := d_isclose i s_elect ss
    b := d_isclose i s_elect bs
    0 = t_ally sh ? ""
    _ := ((0 < t_ally b) & n_ot "(" m_atch 1 t_ake b) h:r_equire "a shape [N O] goes after the stage's name: " c_at sh
    _ := (("]" m_atch -1 t_ake sh) & (1 = t_ally w_here sh m_ember? "]") & 1 = t_ally w_here sh m_ember? "[") h:r_equire "a shape is [extents] at the stage's end, nothing after it: " c_at sh
    items := t:w_ords 1 d_rop -1 d_rop sh
    ((0 < t_ally items) & '& r_/ '{ w -> '& r_/ (d_isclose w) m_ember? plainChars } e_ach items) h:r_equire "a shape's extents are names or numbers, blanks between: " c_at sh
  } m_ap is
}

### Writing the code

## The expansion: a block binding each stage's value, one line per
## stage (a fresh name from []G_ENSYM, or the name given), the shape
## checks after their stages, and the last value as the result.
h:w_rite := { (es, bs, ss) ->
  n := t_ally es
  names := '{ i -> b := d_isclose i s_elect bs; 0 = t_ally b ? []G_ENSYM "stage"; b } m_ap r_ange n
  lines := '{ i -> (es, ss, names) h:l_ine i } m_ap r_ange n
  "{ @ ->\n" c_at ("" t:j_oin lines) c_at "  " c_at (d_isclose n s_elect names) c_at "\n} @"
}

## Stage i's line: the data as written; an expression naming it in a
## block of its own (it := the previous value); a function applied to
## the previous value; an expression of earlier names as written; then
## its shape check, if any.
h:l_ine := { (es, ss, names) i ->
  e := d_isclose i s_elect es
  name := d_isclose i s_elect names
  check := (i, name) h:c_heckOf d_isclose i s_elect ss
  i = 1 ? "  " c_at name c_at " := " c_at e c_at "\n" c_at check
  prev := d_isclose (i - 1) s_elect names
  h:i_t? e ? "  " c_at name c_at " := { @ ->\n    it := " c_at prev c_at "\n    " c_at e c_at "\n  } @\n" c_at check
  h:f_unction? e ? "  " c_at name c_at " := " c_at (h:a_pplied e) c_at " " c_at prev c_at "\n" c_at check
  "  " c_at name c_at " := " c_at e c_at "\n" c_at check
}

## A function stage as applied to a value: a quoted lambda or quoted
## name loses its quote ('{ x -> ... } and 'n_eg are the function
## passed, { x -> ... } v and n_eg v the call); a derived function
## ('+ r_/), a train and a name stay as written.
h:a_pplied := { e ->
  n_ot "'" m_atch 1 t_ake e ? e
  ("'{" m_atch 2 t_ake e) | 0 = t_ally w_here e m_ember? " " ? 1 d_rop e
  e
}

## The check of stage i's shape sh, "" when it has none.
h:c_heckOf := { (i, name) sh ->
  0 = t_ally sh ? ""
  (i, name) h:c_heck sh
}

## The run-time check of a stage's shape: nothing when it matches,
## else error[shape] naming the stage, its shape and the one expected
## (the extents are the caller's values when the program runs).
h:c_heck := { (i, name) sh ->
  expected := "r_avel " c_at " c_at " t:j_oin t:w_ords 1 d_rop -1 d_rop sh
  "  _ := { @ ->\n    ((s_hape " c_at name c_at ") m_atch " c_at expected c_at ") ? @\n    \"shape\" []S_IGNAL \"stage " c_at (f_ormat i) c_at " (" c_at name c_at "): shape \" c_at (f_ormat s_hape " c_at name c_at ") c_at \", expected \" c_at f_ormat " c_at expected c_at "\n  } @\n"
}

### Writing the call back

## The pipeline as read, one line: the stages with " |> " between,
## " $name" and " [shape]" where given.
h:s_how := { (es, bs, ss) ->
  one := '{ i -> (d_isclose i s_elect es) c_at (" $" h:o_pt d_isclose i s_elect bs) c_at " " h:o_pt d_isclose i s_elect ss } m_ap r_ange t_ally es
  " |> " t:j_oin one
}

## pre and x, or "" when x is empty.
h:o_pt := { pre x ->
  0 = t_ally x ? ""
  pre c_at x
}

## s as the inside of a string literal: a quote becomes \".
h:e_scape := { s -> "" t:j_oin '{ ch -> (ch m_ember? "\"") ? "\\\""; ch } m_ap s }

### Text helpers

## Nothing when ok holds; else the call is refused with message, at
## its text (the right side).
h:r_equire := { ok message ->
  ok ? ""
  "bad-pipeline right" []R_EJECT message
}

## Characters of names: of values (Q, m1), of functions (nn:r_elu,
## n_ame?, p_rint!), and digits.
nameChars := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_:?!"
## Characters of plain names and numbers.
plainChars := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
letters := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

## 1 at each character of s inside a string literal (its quotes included).
h:q_uoted := { s -> ('+ s_\ 0 + s m_ember? "\"") m_od 2 }

## The positions in s where sep starts outside brackets, braces,
## parentheses and strings.
h:o_utside := { sep s ->
  q := h:q_uoted s
  d := '+ s_\ ((0 + s m_ember? "([{") - 0 + s m_ember? ")]}") * 1 - q
  ps := sep t:f_ind s
  (((ps s_elect d) = 0) & 0 = ps s_elect q) r_eplicate ps
}

## s cut where sep starts outside brackets and strings: the pieces
## between, boxed (one piece when it never does).
h:s_plit := { sep s ->
  ps := sep h:o_utside s
  m := t_ally sep
  starts := 1 c_at ps + m
  ends := ps c_at 1 + t_ally s
  '{ i -> ((i s_elect ends) - i s_elect starts) t_ake ((i s_elect starts) - 1) d_rop s } m_ap r_ange t_ally starts
}

## The first of the boxed texts b ("" for none).
h:f_irstText := { b ->
  0 = t_ally b ? ""
  d_isclose f_irst b
}

## The first of the positions ps, or 0 for none.
h:f_irst := { ps ->
  0 = t_ally ps ? 0
  f_irst ps
}

## Where the first ch is in s, or 0.
h:f_irstOf := { ch s -> h:f_irst w_here s m_ember? ch }

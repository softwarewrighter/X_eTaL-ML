headM := ((r#"\begin{aligned} "# c_at r#"& "# c_at r#"X"# c_at
    r#" \qquad \triangleright \, x \\ "# c_at r#"\longrightarrow \; & "# c_at (("Q_{i,d} = \\sum_{f=0}^{3} x_{i,f} \\, Wq_{f,d}"))
    c_at r#" \qquad \triangleright \, q \\ "# c_at r#"\longrightarrow \; & "#
    c_at (("K_{j,d} = \\sum_{f=0}^{3} x_{j,f} \\, Wk_{f,d}")) c_at
    r#" \qquad \triangleright \, k \\ "# c_at r#"\longrightarrow \; & "# c_at (("V_{j,d} = \\sum_{f=0}^{3} x_{j,f} \\, Wv_{f,d}"))
    c_at r#" \qquad \triangleright \, v \\ "# c_at r#"\longrightarrow \; & "#
    c_at (("S_{i,j} = \\frac{\\sum_{d=0}^{1} q_{i,d} \\, k_{j,d}}{\\sqrt{2.0}}"))
    c_at r#" \qquad \triangleright \, s \\ "# c_at r#"\longrightarrow \; & "#
    c_at (("A_{i,j} = \\frac{M_{i,j} \\, \\exp(s_{i,j})}{\\sum_{m=0}^{2} M_{i,m} \\, \\exp(s_{i,m})}"))
    c_at r#" \qquad \triangleright \, a \\ "# c_at r#"\longrightarrow \; & "#
    c_at (("Y_{i,d} = \\sum_{j=0}^{2} a_{i,j} \\, v_{j,d}")) c_at r#""# c_at
    r#" \end{aligned}"#))
headM

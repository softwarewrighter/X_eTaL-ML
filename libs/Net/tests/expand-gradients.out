#!/usr/bin/env xetal
# Net: the gradients g_radient< writes equal finite differences, for
# networks of every activation, checked with Check.
"nn:" u_se< "NN"
"net:" u_se< "Net"
"k:" u_se< "Check"
X := 5 3 r_eshape 0.3 -0.7 1.1 0.0 2.0 -1.5 0.9 0.4
Y := 3 nn:o_neHot 1 3 2 2 1
w1 := 4 5 r_eshape 0.5 -1.0 0.25 2.0 0.0 -0.5 1.0 1.5 -2.0 0.1 0.2 0.3 -0.4
w2 := 6 4 r_eshape 1.0 -1.0 0.5 0.5 -0.25 2.0 0.0 0.1 0.7
w3 := 5 3 r_eshape 0.2 -0.6 0.9 -0.1 0.4
v1 := 4 3 r_eshape 0.8 -0.3 0.5 0.1 -0.9
u:g_a := { (W1, W2, W3) ->
  A0 := X
  A1 := nn:r_elu A0 nn:d_ense W1
  A2 := nn:s_igmoid A1 nn:d_ense W2
  A3 := nn:s_oftmax A2 nn:d_ense W3
  D3 := (A3 - Y) / f_loat t_ally X
  D2 := (D3 '+ '* i_nner o_\ -1 d_rop W3) * A2 * 1.0 - A2
  D1 := (D2 '+ '* i_nner o_\ -1 d_rop W2) * f_loat A1 > 0.0
  G1 := (o_\ A0 c_at_2 ((t_ally A0) c_at 1) r_eshape 1.0) '+ '* i_nner D1
  G2 := (o_\ A1 c_at_2 ((t_ally A1) c_at 1) r_eshape 1.0) '+ '* i_nner D2
  G3 := (o_\ A2 c_at_2 ((t_ally A2) c_at 1) r_eshape 1.0) '+ '* i_nner D3
  (G1, G2, G3)
}
u:g_b := { (W1, W2, W3) ->
  A0 := X
  A1 := nn:t_anh A0 nn:d_ense W1
  A2 := A1 nn:d_ense W2
  A3 := nn:s_oftmax A2 nn:d_ense W3
  D3 := (A3 - Y) / f_loat t_ally X
  D2 := (D3 '+ '* i_nner o_\ -1 d_rop W3)
  D1 := (D2 '+ '* i_nner o_\ -1 d_rop W2) * 1.0 - A1 * A1
  G1 := (o_\ A0 c_at_2 ((t_ally A0) c_at 1) r_eshape 1.0) '+ '* i_nner D1
  G2 := (o_\ A1 c_at_2 ((t_ally A1) c_at 1) r_eshape 1.0) '+ '* i_nner D2
  G3 := (o_\ A2 c_at_2 ((t_ally A2) c_at 1) r_eshape 1.0) '+ '* i_nner D3
  (G1, G2, G3)
}
u:g_c := { W1 ->
  A0 := X
  A1 := nn:s_oftmax A0 nn:d_ense W1
  D1 := (A1 - Y) / f_loat t_ally X
  G1 := (o_\ A0 c_at_2 ((t_ally A0) c_at 1) r_eshape 1.0) '+ '* i_nner D1
  G1
}
# The loss of weights w (a tuple) for each network.
u:l_a := { (a, b, c) -> Y nn:c_rossEntropy nn:s_oftmax (nn:s_igmoid (nn:r_elu X nn:d_ense a) nn:d_ense b) nn:d_ense c }
u:l_b := { (a, b, c) -> Y nn:c_rossEntropy nn:s_oftmax ((nn:t_anh X nn:d_ense a) nn:d_ense b) nn:d_ense c }
u:l_c := { a -> Y nn:c_rossEntropy nn:s_oftmax X nn:d_ense a }
# e at item i of an array shaped as w, 0 elsewhere.
e := 0.00001
u:b_ump := { w i -> e * f_loat (s_hape w) r_eshape i = r_ange t_ally r_avel w }
u:g_ap := { g f -> 'm_ax r_/ r_avel a_bs g - f }
# Each layer's finite differences, (L(w + e) - L(w - e)) / 2e per item.
(A1, A2, A3) := u:g_a (w1, w2, w3)
FA1 := (s_hape w1) r_eshape '{ i -> ((u:l_a (w1 + w1 u:b_ump i, w2, w3)) - u:l_a (w1 - w1 u:b_ump i, w2, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w1
FA2 := (s_hape w2) r_eshape '{ i -> ((u:l_a (w1, w2 + w2 u:b_ump i, w3)) - u:l_a (w1, w2 - w2 u:b_ump i, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w2
FA3 := (s_hape w3) r_eshape '{ i -> ((u:l_a (w1, w2, w3 + w3 u:b_ump i)) - u:l_a (w1, w2, w3 - w3 u:b_ump i)) / 2.0 * e } e_ach r_ange t_ally r_avel w3
(B1, B2, B3) := u:g_b (w1, w2, w3)
FB1 := (s_hape w1) r_eshape '{ i -> ((u:l_b (w1 + w1 u:b_ump i, w2, w3)) - u:l_b (w1 - w1 u:b_ump i, w2, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w1
FB2 := (s_hape w2) r_eshape '{ i -> ((u:l_b (w1, w2 + w2 u:b_ump i, w3)) - u:l_b (w1, w2 - w2 u:b_ump i, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w2
FB3 := (s_hape w3) r_eshape '{ i -> ((u:l_b (w1, w2, w3 + w3 u:b_ump i)) - u:l_b (w1, w2, w3 - w3 u:b_ump i)) / 2.0 * e } e_ach r_ange t_ally r_avel w3
C1 := u:g_c v1
FC1 := (s_hape v1) r_eshape '{ i -> ((u:l_c v1 + v1 u:b_ump i) - u:l_c v1 - v1 u:b_ump i) / 2.0 * e } e_ach r_ange t_ally r_avel v1
c1 := "relu, sigmoid, softmax" k:t_est k:t_rue 0.0000001 > (A1 u:g_ap FA1) m_ax (A2 u:g_ap FA2) m_ax A3 u:g_ap FA3
c2 := "tanh, none, softmax" k:t_est k:t_rue 0.0000001 > (B1 u:g_ap FB1) m_ax (B2 u:g_ap FB2) m_ax B3 u:g_ap FB3
c3 := "one layer, softmax: one array in, one out" k:t_est k:t_rue 0.0000001 > C1 u:g_ap FC1
c4 := "each gradient has its weights' shape" k:t_est ((s_hape w1) c_at (s_hape w2) c_at s_hape w3) k:i_s (s_hape A1) c_at (s_hape A2) c_at s_hape A3
k:r_eport c1 k:a_nd c2 k:a_nd c3 k:a_nd c4


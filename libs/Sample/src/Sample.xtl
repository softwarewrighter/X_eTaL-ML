## Sample: choosing the next token from scores: greedy, temperature, top-k, drawing by given uniform numbers
##
## Import it with an alias of your choice: "sm:" u_se< "Sample".
## Put libs/Sample/src on XETAL_PATH ("just path"); the reference is libs/Sample/docs.
## Names with l: are exported; h: names are private to this file.
##
## Scores (logits) are a row per position, a column per token; tokens
## count from 1. The library draws no chance itself: a draw takes
## uniform numbers in 0 .. 1 from the caller (r_oll!, seeded, or any
## other source), so the same numbers give the same tokens.

"nn:" u_se< "NN"

## A value per row spread across that row's columns (of an n x m matrix).
h:s_pread := { v m -> v 'l_eft t_able o_ffsets 2 s_elect s_hape m }

### Choosing

## `g_reedy s`: the most likely token of each row.
## >> "sm:" u_se< "Sample"
## >> sm:g_reedy 2 3 r_eshape 0.1 2.0 0.5 3.0 0.0 1.0
## 2 1
l:g_reedy := { s -> nn:a_rgmax s }

## `t p_robs s`: the probabilities at temperature t: softmax of the
## scores over t (below 1 sharper, above 1 flatter).
## >> "sm:" u_se< "Sample"
## >> 1.0 sm:p_robs 0.0 0.6931471805599453
## 0.3333333333333333 0.6666666666666666
l:p_robs := { t s -> nn:s_oftmax s / t }

## `k t_op p`: only each row's k largest probabilities kept (the rest
## 0), then scaled to sum to 1 again. On a tie at the k-th, all tied
## are kept.
## >> "sm:" u_se< "Sample"
## >> 2 sm:t_op 0.1 0.5 0.15 0.25
## 0.0 0.6666666666666666 0.0 0.3333333333333333
l:t_op := { k p ->
  m := ((t_ally r_avel p) d_iv -1 t_ake s_hape p) c_at -1 t_ake s_hape p
  rows := m r_eshape p
  ## Each row's k-th largest: its largest taken and shifted below the
  ## rest, k times (X_eTaL has no grade along a row yet). The shift is
  ## finite, 1 + the range of the values, so it runs in 32-bit floats
  ## too (a huge constant is infinity there, and 0 times it NaN).
  (_, kth) := k '{ (q, t) ->
    top := 'm_ax r_/_2 q
    (q - (1.0 + ('m_ax r_/ r_avel q) - 'm_in r_/ r_avel q) * f_loat q >= top h:s_pread q, top)
  } p_ower (rows, (1 t_ake m) r_eshape 0.0)
  kept := rows * f_loat rows >= kth h:s_pread rows
  (s_hape p) r_eshape kept / ('+ r_/_2 kept) h:s_pread kept
}

## `u d_raw p`: a token for each row of probabilities p, drawn by the
## uniform number u (one per row): the first token where the running
## sum of the row passes u.
## >> "sm:" u_se< "Sample"
## >> 0.1 0.7 sm:d_raw 2 3 r_eshape 0.2 0.3 0.5 0.2 0.3 0.5
## 1 3
l:d_raw := { u p ->
  m := ((t_ally r_avel p) d_iv -1 t_ake s_hape p) c_at -1 t_ake s_hape p
  c := '+ s_\_2 m r_eshape p
  1 + '+ r_/_2 c < u 'l_eft t_able o_ffsets 2 s_elect m
}

#!/usr/bin/env xetal
# Flow: short pipelines against the same computation written as
# plain X_eTaL, over every kind of stage and their orders: a function
# applied, it on either side of a dyad, an earlier name, a tuple taken
# apart, a function stage after a named one, a quoted lambda, a train.
"flow:" u_se< "Flow"
"k:" u_se< "Check"
x := f_loat 1 2 3 4
M := 2 2 r_eshape f_loat 1 2 3 4
# functions in turn
c1 := "f g" k:t_est (@ flow:p_ipe< c"x |> n_eg |> e_xp") k:n_ear e_xp n_eg x
# it on the left and on the right of a dyad: the order is written
c2 := "it - m" k:t_est (@ flow:p_ipe< c"x |> 'm_ax r_/ it $m |> x - m") k:n_ear x - 'm_ax r_/ x
c3 := "m - it" k:t_est (@ flow:p_ipe< c"x |> 'm_ax r_/ it $m |> m - x") k:n_ear ('m_ax r_/ x) - x
c4 := "it twice in a stage" k:t_est (@ flow:p_ipe< c"x |> it * it") k:n_ear x * x
# a quoted lambda and a train as functions
c5 := "a quoted lambda" k:t_est (@ flow:p_ipe< c"x |> '{ v -> v * 2.0 }") k:n_ear 2.0 * x
t6 := [n_eg r_ev] x
c6 := "a train" k:t_est (@ flow:p_ipe< c"x |> [n_eg r_ev]") k:n_ear t6
c6b := "a quoted name" k:t_est (@ flow:p_ipe< c"x |> 'n_eg") k:n_ear n_eg x
# a tuple taken apart, then used by name and as it
c7 := "a tuple" k:t_est (@ flow:p_ipe< c"x |> (it, 2.0 * it) $(a, b) |> a + b") k:n_ear 3.0 * x
c8 := "a tuple is it too" k:t_est (@ flow:p_ipe< c"x |> (it, 2.0 * it) $(a, b) |> (p, q) := it; q - p") k:n_ear x
# a function after a named stage, and the name of the last stage
c9 := "f after a $name" k:t_est (@ flow:p_ipe< c"x $s |> n_eg $t |> e_xp") k:n_ear e_xp n_eg x
c10 := "the last stage named" k:t_est (@ flow:p_ipe< c"x |> n_eg $t") k:n_ear n_eg x
# a matrix: the stages are any X_eTaL
c11 := "a matrix product" k:t_est (@ flow:p_ipe< c"M |> it '+ '* i_nner M |> o_\\ it") k:n_ear o_\ M '+ '* i_nner M
c12 := "a shape that holds" k:t_est (@ flow:p_ipe< c"M |> it '+ '* i_nner M $P [2 2] |> r_avel P $v [4]") k:n_ear r_avel M '+ '* i_nner M
# one stage only: the data
c13 := "the data alone" k:t_est (@ flow:p_ipe< c"x") k:n_ear x
# a plain and a raw string read the same as a code string
p14 := @ flow:p_ipe< "x |> 'm_ax r_/ it $m |> x - m"
c14 := "plain, raw and code strings alike" k:t_est p14 k:n_ear @ flow:p_ipe< c"x |> 'm_ax r_/ it $m |> x - m"
c15 := "raw" k:t_est (@ flow:p_ipe< r"
   x
|> n_eg") k:n_ear @ flow:p_ipe< c"x |> n_eg"
k:r_eport c1 k:a_nd c2 k:a_nd c3 k:a_nd c4 k:a_nd c5 k:a_nd c6 k:a_nd c6b k:a_nd c7 k:a_nd c8 k:a_nd c9 k:a_nd c10 k:a_nd c11 k:a_nd c12 k:a_nd c13 k:a_nd c14 k:a_nd c15

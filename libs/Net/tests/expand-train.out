#!/usr/bin/env xetal
# Net: the training step t_rain< writes is train-live's hand-written
# one (the backprop microscope's gradient and Adam), checked with Check
# after 20 steps on the same spiral from the same start.
"nn:" u_se< "NN"
"net:" u_se< "Net"
"k:" u_se< "Check"
n := 60
i := o_ffsets n
arm := i d_iv 20
t := (0.5 + f_loat i m_od 20) / 20.0
a := (2.0944 * f_loat arm) + 5.5 * t
X := o_\ (2 c_at n) r_eshape ((0.1 + 0.9 * t) * c_os a) c_at (0.1 + 0.9 * t) * s_in a
Y := 3 nn:o_neHot 1 + arm
lr := 0.02
# By hand, as demos/train-live writes it.
u:o_nes := { x -> x c_at_2 ((t_ally x) c_at 1) r_eshape 1.0 }
u:g_rad := { W1 W2 ->
  H := nn:t_anh X nn:d_ense W1
  D2 := ((nn:s_oftmax H nn:d_ense W2) - Y) / f_loat n
  D1 := (D2 '+ '* i_nner o_\ -1 d_rop W2) * 1.0 - H * H
  ((o_\ u:o_nes X) '+ '* i_nner D1, (o_\ u:o_nes H) '+ '* i_nner D2)
}
u:m_ove := { (m, v) k -> (m / 1.0 - 0.9 ^ k) / 0.00000001 + (v / 1.0 - 0.999 ^ k) ^ 0.5 }
u:h_and := { (W1, W2, M1, M2, V1, V2, k) ->
  k := 1.0 + k
  (G1, G2) := W1 u:g_rad W2
  M1 := (0.9 * M1) + 0.1 * G1
  M2 := (0.9 * M2) + 0.1 * G2
  V1 := (0.999 * V1) + 0.001 * G1 * G1
  V2 := (0.999 * V2) + 0.001 * G2 * G2
  (W1 - lr * (M1, V1) u:m_ove k, W2 - lr * (M2, V2) u:m_ove k, M1, M2, V1, V2, k)
}
# By the macro, from the spec.
u:m_acro := { (g1:W1, g2:W2, g3:M1, g4:M2, g5:V1, g6:V2, g7:k) ->
  g8:A0 := X
  g9:A1 := nn:t_anh g8:A0 nn:d_ense g1:W1
  g10:A2 := nn:s_oftmax g9:A1 nn:d_ense g2:W2
  g11:D2 := (g10:A2 - Y) / f_loat t_ally X
  g12:D1 := (g11:D2 '+ '* i_nner o_\ -1 d_rop g2:W2) * 1.0 - g9:A1 * g9:A1
  g13:G1 := (o_\ g8:A0 c_at_2 ((t_ally g8:A0) c_at 1) r_eshape 1.0) '+ '* i_nner g12:D1
  g14:G2 := (o_\ g9:A1 c_at_2 ((t_ally g9:A1) c_at 1) r_eshape 1.0) '+ '* i_nner g11:D2
  g7:k := 1.0 + g7:k
  g3:M1 := (0.9 * g3:M1) + 0.1 * g13:G1
  g5:V1 := (0.999 * g5:V1) + 0.001 * g13:G1 * g13:G1
  g1:W1 := g1:W1 - lr * (g3:M1 / 1.0 - 0.9 ^ g7:k) / 0.00000001 + (g5:V1 / 1.0 - 0.999 ^ g7:k) ^ 0.5
  g4:M2 := (0.9 * g4:M2) + 0.1 * g14:G2
  g6:V2 := (0.999 * g6:V2) + 0.001 * g14:G2 * g14:G2
  g2:W2 := g2:W2 - lr * (g4:M2 / 1.0 - 0.9 ^ g7:k) / 0.00000001 + (g6:V2 / 1.0 - 0.999 ^ g7:k) ^ 0.5
  (g1:W1, g2:W2, g3:M1, g4:M2, g5:V1, g6:V2, g7:k)
}
w1 := 3 16 r_eshape 0.31 -0.42 0.17 0.05 -0.28 0.44 -0.13 0.36
w2 := 17 3 r_eshape -0.21 0.33 0.08 -0.39 0.26
s0 := ((w1, w2, 0.0 * w1, 0.0 * w2, 0.0 * w1, 0.0 * w2, 0.0))
(a1, a2, _, _, _, av2, _) := 20 'u:h_and p_ower s0
(b1, b2, _, _, _, bv2, bk) := 20 'u:m_acro p_ower s0
u:l_oss := { W1 W2 -> Y nn:c_rossEntropy nn:s_oftmax (nn:t_anh X nn:d_ense W1) nn:d_ense W2 }
c1 := "W1 as by hand" k:t_est a1 k:n_ear b1
c2 := "W2 as by hand" k:t_est a2 k:n_ear b2
c3 := "Adam's averages as by hand" k:t_est (r_avel av2) k:n_ear r_avel bv2
c4 := "twenty steps counted" k:t_est 20.0 k:n_ear bk
c5 := "the loss falls" k:t_est k:t_rue (b1 u:l_oss b2) < w1 u:l_oss w2
k:r_eport c1 k:a_nd c2 k:a_nd c3 k:a_nd c4 k:a_nd c5


#!/usr/bin/env xetal
# NN: a_ddAxis and b_ias add a vector along an axis, checked against
# the same written out with r_eshape and t_ranspose; b_ias picks the
# axis by rank (the last for rows, the channel axis for channel-first
# pictures and batches of them).
"nn:" u_se< "NN"
"k:" u_se< "Check"
M := 2 3 r_eshape f_loat r_ange 6
b := 10.0 20.0 30.0
V := 2 3 4 r_eshape f_loat r_ange 24
# As the page shows them.
b nn:b_ias M
(1, 100.0 200.0) nn:a_ddAxis M
r_avel b nn:b_ias 3 2 2 r_eshape 0.0
c1 := "the last axis of a matrix, as d_ense writes a bias" k:t_est (b nn:b_ias M) k:n_ear M + (s_hape M) r_eshape b
c2 := "a_ddAxis on the last axis is b_ias" k:t_est ((2, b) nn:a_ddAxis M) k:n_ear b nn:b_ias M
c3 := "the first axis of a matrix" k:t_est ((1, 100.0 200.0) nn:a_ddAxis M) k:n_ear M + o_\ (3 2 r_eshape 100.0 200.0)
c4 := "the middle axis of a rank-3 array" k:t_est ((2, b) nn:a_ddAxis V) k:n_ear V + 1 3 2 t_ranspose 2 4 3 r_eshape b
c5 := "a vector: its one axis" k:t_est (1.0 2.0 nn:b_ias 5.0 7.0) k:n_ear 6.0 9.0
# A channel-first picture (channels, height, width) and a batch of them.
P := 3 2 2 r_eshape 0.0
c6 := "a picture's bias goes on the channel axis" k:t_est (b nn:b_ias P) k:n_ear (1, b) nn:a_ddAxis P
c7 := "the channels of one picture" k:t_est (r_avel b nn:b_ias P) k:n_ear 10.0 10.0 10.0 10.0 20.0 20.0 20.0 20.0 30.0 30.0 30.0 30.0
B4 := 2 3 2 2 r_eshape 0.0
c8 := "a batch of pictures: the second axis" k:t_est (b nn:b_ias B4) k:n_ear (2, b) nn:a_ddAxis B4
c9 := "each picture of the batch alike" k:t_est (1 s_elect b nn:b_ias B4) k:n_ear b nn:b_ias P
k:r_eport c1 k:a_nd c2 k:a_nd c3 k:a_nd c4 k:a_nd c5 k:a_nd c6 k:a_nd c7 k:a_nd c8 k:a_nd c9

#!/usr/bin/env xetal
## lo:a_dapter< checks A and B against the rank when the program runs:
## at rank 2 these are of rank 1, and the program stops.
"lo:" u_se< "LoRA"
W := 2 2 r_eshape 1.0 0.0 0.0 1.0
A := 1 2 r_eshape 1.0 1.0
B := 2 1 r_eshape 1.0 -1.0
s := 0.5
_ := { v ->
  v ? 0
  []P_ANIC "lo:a_dapter<: A must be 2 x n and B m x 2 for \"W A B s | r 2 | train A B\""
} (2 = f_irst s_hape A) & 2 = 2 s_elect s_hape B
u:f_wd := { g3:x -> (W '+ '* i_nner g3:x) + s * B '+ '* i_nner A '+ '* i_nner g3:x }
u:b_wd := { (g3:x, g2:g) ->
  g1:b := (o_\ B) '+ '* i_nner g2:g
  (s * g1:b '+ '* i_nner o_\ g3:x, s * g2:g '+ '* i_nner o_\ A '+ '* i_nner g3:x,
    ((o_\ W) '+ '* i_nner g2:g) + s * (o_\ A) '+ '* i_nner g1:b)
}
u:f_wd 2 1 r_eshape 2.0 4.0


#!/usr/bin/env xetal
## Three networks for one task (which of three spiral arms is a point
## on?), each described once, by one line: the Net macro library turns
## a spec, sizes and activations, into the loading of the weights and
## an ordinary function of NN calls before the program is compiled.
## xetal expand shows what it wrote.

"nn:" u_se< "NN"
"net:" u_se< "Net"

### The data, read from data/ (just net-train)
## The test points, one per line: x, y and the arm (1, 2 or 3).
pts := n_umbers []N_GET "data/points.txt"
pts := o_\ (((t_ally pts) d_iv 3) c_at 3) r_eshape pts
xy := o_\ 2 t_ake pts
arm := f_loor 3 s_elect pts

### The networks: each described once
## From a spec the macro writes the loading of each dense layer's
## weights (data/a1.txt, ...: inputs + 1 by outputs, the bias last; the
## program stops, naming the layer, if a file holds the wrong count)
## and the forward function.
"u:l_inear a" net:m_odel< "2 3 softmax"
"u:s_mall b" net:m_odel< "2 4 tanh 3 softmax"
"u:d_eep c" net:m_odel< "2 16 relu 16 relu 3 softmax"
# -- end of the core --------------------------------------

# How many numbers each has to learn, counted by the macro when the
# program is compiled.
("2 3 softmax" net:p_arams< @) c_at ("2 4 tanh 3 softmax" net:p_arams< @) c_at "2 16 relu 16 relu 3 softmax" net:p_arams< @
# The share of the 120 test points each reads right: a line cannot
# follow a spiral, a small network nearly can, the deep one does.
(arm nn:a_ccuracy u:l_inear xy) c_at (arm nn:a_ccuracy u:s_mall xy) c_at arm nn:a_ccuracy u:d_eep xy
## What each decides over the square -1.1 .. 1.1 (a, b, c: the arms).
g := 20
c := -1.1 + 2.2 * (0.5 + f_loat o_ffsets g) / f_loat g
grid := o_\ (2 c_at g * g) r_eshape (r_avel (o_ffsets g) 'r_ight t_able c) c_at r_avel (r_ev c) 'l_eft t_able o_ffsets g
u:a_rms := { y -> (g c_at g) r_eshape (nn:a_rgmax y) s_elect "abc" }
u:a_rms u:l_inear grid
u:a_rms u:s_mall grid
u:a_rms u:d_eep grid

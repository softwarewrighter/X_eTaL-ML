    ((g174:r_ank (T, "T", 2, "T[i,k]")) g176:a_t ((
      ((T, "T", 2, "k") g175:c_heck (0 + g178:g_rid 2)) + (2 s_elect s_hape T) *
            
      ((T, "T", 1, "i") g175:c_heck (0 + g178:g_rid 1)))))))
  } @))
  gz := (({ @ ->
    g181:a_t := { A i -> (1 + i) s_elect r_avel A }
    g180:c_heck := { (A, name, k, from) e ->
      n := k s_elect s_hape A
      bad := w_here n_ot r_avel (0 <= e) & e < n
      0 = t_ally bad ? e
      "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
    }
    g179:r_ank := { (A, name, q, ref) ->
      (t_ally s_hape A) = q ? A
      "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
    }
    g182:grid := n c_at 2
    g183:g_rid := { k ->
      g182:grid r_eshape (o_ffsets k s_elect g182:grid) 'l_eft t_able ('* r_/ k d_rop g182:grid) r_eshape 0
    }
    g182:grid r_eshape (((
    ((g179:r_ank (gy, "gy", 2, "gy[i,k]")) g181:a_t ((
      ((gy, "gy", 2, "k") g180:c_heck (0 + g183:g_rid 2)) + (2 s_elect s_hape gy)
              * 
      ((gy, "gy", 1, "i") g180:c_heck (0 + g183:g_rid 1))))) * 
    ((g179:r_ank (y, "y", 2, "y[i,k]")) g181:a_t ((
      ((y, "y", 2, "k") g180:c_heck (0 + g183:g_rid 2)) + (2 s_elect s_hape y) *
              
      ((y, "y", 1, "i") g180:c_heck (0 + g183:g_rid 1)))))) * ((1 - 
    ((g179:r_ank (y, "y", 2, "y[i,k]")) g181:a_t ((
      ((y, "y", 2, "k") g180:c_heck (0 + g183:g_rid 2)) + (2 s_elect s_hape y) *
                
      ((y, "y", 1, "i") g180:c_heck (0 + g183:g_rid 1)))))))))
  } @))
  gw := (({ @ ->
    g186:a_t := { A i -> (1 + i) s_elect r_avel A }
    g185:c_heck := { (A, name, k, from) e ->
      n := k s_elect s_hape A
      bad := w_here n_ot r_avel (0 <= e) & e < n
      0 = t_ally bad ? e
      "index" []S_IGNAL name c_at " axis " c_at (f_ormat k) c_at ": index " c_at (f_ormat (f_irst bad) s_elect r_avel e) c_at " is outside 0.." c_at (f_ormat n - 1) c_at " (from " c_at from c_at ")"
    }
    g184:r_ank := { (A, name, q, ref) ->
      (t_ally s_hape A) = q ? A
      "rank" []S_IGNAL ref c_at " indexes " c_at (f_ormat q) c_at " axes, but " c_at name c_at " has rank " c_at f_ormat t_ally s_hape A
    }
    g187:grid := 3 c_at 2
    g188:g_rid := { k ->
      g187:grid r_eshape (o_ffsets k s_elect g187:grid) 'l_eft t_able ('* r_/ k d_rop g187:grid) r_eshape 0
    }
    g187:grid r_eshape (({ @ ->
      g189:grid := 3 c_at 2 c_at ({ v ->
      (0 <= v) ? v
      "bad-equation" []S_IGNAL "sum's range runs low..high: 0..n-1"
    } (1 + (n - 1) - 0))
      g190:g_rid := { k ->
        g189:grid r_eshape (o_ffsets k s_elect g189:grid) 'l_eft t_able ('* r_/ k d_rop g189:grid) r_eshape 0
      }
      '+ r_/_3 g189:grid r_eshape ((
    ((g184:r_ank (x, "x", 2, "x[i,c]")) g186:a_t ((
      ((x, "x", 2, "c") g185:c_heck (0 + g190:g_rid 1)) + (2 s_elect s_hape x) *
              
      ((x, "x", 1, "i") g185:c_heck (0 + g190:g_rid 3))))) * 
    ((g184:r_ank (gz, "gz", 2, "gz[i,k]")) g186:a_t ((
      ((gz, "gz", 2, "k") g185:c_heck (0 + g190:g_rid 2)) + (2 s_elect s_hape gz)
              * 
      ((gz, "gz", 1, "i") g185:c_heck (0 + g190:g_rid 3)))))))
    } @))
  } @))
  _ := { @ ->
    ((s_hape gw) m_atch r_avel 3 c_at 2) ? @
    "shape" []S_IGNAL "stage 7 (gw): shape " c_at (f_ormat s_hape gw) c_at ", expected " c_at f_ormat r_avel 3 c_at 2
  } @
  gw
} @)
backDrawn := ((r#"\begin{aligned} "# c_at r#"& "# c_at r#"X"# c_at
    r#" \qquad \triangleright \, x \\ "# c_at r#"\longrightarrow \; & "# c_at (("Z_{i,k} = \\sum_{c=0}^{2} x_{i,c} \\, Wc_{c,k}"))
    c_at r#" \qquad \triangleright \, z \\ "# c_at r#"\longrightarrow \; & "#
    c_at (("Y_{i,k} = \\frac{1}{1 + \\exp(-z_{i,k})}")) c_at
    r#" \qquad \triangleright \, y \\ "# c_at r#"\longrightarrow \; & "# c_at (("L = \\frac{\\sum_{i=0}^{n - 1} \\sum_{k=0}^{1} \\left(y_{i,k} - T_{i,k}\\right)^{2}}{2}"))
    c_at r#" \qquad \triangleright \, l \\ "# c_at r#"\longrightarrow \; & "#
    c_at (("Gy_{i,k} = y_{i,k} - T_{i,k}")) c_at
    r#" \qquad \triangleright \, gy \\ "# c_at r#"\longrightarrow \; & "# c_at (("Gz_{i,k} = gy_{i,k} \\, y_{i,k} \\, \\left(1 - y_{i,k}\\right)"))
    c_at r#" \qquad \triangleright \, gz \\ "# c_at r#"\longrightarrow \; & "#
    c_at (("Gw_{c,k} = \\sum_{i=0}^{n - 1} x_{i,c} \\, gz_{i,k}")) c_at
    r#" \qquad \triangleright \, gw: 3 \times 2"# c_at r#" \end{aligned}"#))
backDrawn
## The same gradient written out (as the backprop demo writes it), and
## by nudging each weight: the loss's change over twice the nudge.
Y0 := 1.0 / 1.0 + e_xp n_eg X '+ '* i_nner Wc
back0 := (o_\ X) '+ '* i_nner (Y0 - T) * Y0 * 1.0 - Y0
u:l_oss := { w -> 0.5 * '+ r_/ r_avel ((1.0 / 1.0 + e_xp n_eg X '+ '* i_nner w) - T) ^ 2 }
u:n_udge := { j -> 3 2 r_eshape 0.000001 * f_loat j = r_ange 6 }
nudged := 3 2 r_eshape '{ j -> 500000.0 * (u:l_oss Wc + u:n_udge j) - u:l_oss Wc - u:n_udge j } e_ach r_ange 6
r3 := "the chain rule, stage by stage, is the gradient written out" k:t_est back k:n_ear back0
r4 := "and is what nudging each weight gives, within 1e-7" k:t_est k:t_rue 0.00000000000001 > (back - nudged) ^ 2

k:r_eport r1 k:a_nd r2 k:a_nd r3 k:a_nd r4


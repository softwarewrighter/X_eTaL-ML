#!/usr/bin/env xetal
# NN: every function on small arrays. Run with "just run-lib NN basics".
"nn:" u_se< "NN"
m := 2 3 r_eshape 1.0 2.0 3.0 -1.0 0.0 5.0
nn:r_elu m
0.1 nn:l_eaky m
nn:s_igmoid 0.0 2.0
nn:t_anh 0.0 1.0
nn:s_oftmax 1.0 2.0 3.0
nn:s_oftmax m
nn:l_ogSoftmax m
x := 2 2 r_eshape 1.0 2.0 3.0 4.0
wb := 3 2 r_eshape 1.0 0.0 0.0 2.0 10.0 20.0
x nn:d_ense wb
nn:a_rgmax 1.0 3.0 2.0
nn:a_rgmax m
3 nn:o_neHot 2 1 3
(2 nn:o_neHot 1 2) nn:c_rossEntropy 2 2 r_eshape 0.9 0.1 0.2 0.8
3 2 nn:a_ccuracy m
(2 2 r_eshape 1.0 0.0 0.0 1.0) nn:m_se 2 2 r_eshape 0.5 0.0 0.0 1.0

## Embed: word embeddings from counts: co-occurrence, PPMI, a fixed projection, cosine neighbors
##
## Import it with an alias of your choice: "em:" u_se< "Embed".
## Put libs/Embed/src on XETAL_PATH ("just path"); the reference is libs/Embed/docs.
## Names with l: are exported; h: names are private to this file.
##
## A corpus is a vector of word numbers (from 1), each sentence ended
## by a 0. A word's embedding is a row: which words occur near it,
## weighted by how much more often than chance (PPMI), then projected
## to fewer dimensions. Words used alike get rows that point alike.

"ls:" u_se< "Lists"

### Counting

## `n c_ounts k`: how many times each of 1 .. n occurs in k, by sorting
## (the keys in order, then the length of each run of equal keys).
## >> "em:" u_se< "Embed"
## >> 5 em:c_ounts 3 1 3 3 5
## 1 0 3 0 1
l:c_ounts := { n k ->
  s := (g_rade k) s_elect k
  first := 1 c_at (1 d_rop s) != -1 d_rop s
  at := w_here first
  runs := ((1 d_rop at) c_at 1 + t_ally s) - at
  ((first r_eplicate s) i_ndexOf r_ange n) s_elect runs c_at 0
}

## `(v, w) c_ooccur ids`: a v x v matrix of how often word i occurs
## within w words of word j in the same sentence (both ways).
## >> "em:" u_se< "Embed"
## >> (3, 1) em:c_ooccur 1 2 3 0 1 2 0
## 0 2 0
## 2 0 1
## 0 1 0
l:c_ooccur := { (v, w) ids ->
  sent := '+ s_\ ids = 0
  pairs := '{ d ->
    a := (n_eg d) d_rop ids
    b := d d_rop ids
    ok := (((n_eg d) d_rop sent) = d d_rop sent) & (a > 0) & b > 0
    (ok r_eplicate (v * a - 1) + b) c_at ok r_eplicate (v * b - 1) + a
  } m_ap r_ange w
  (v c_at v) r_eshape (v * v) l:c_ounts ls:r_aze pairs
}

### Weighting and projecting

## `p_pmi C`: positive pointwise mutual information: the log of how
## much more often each pair occurs than if the words were independent,
## 0 where less (or never; a word with no company has a row of 0s).
l:p_pmi := { C ->
  c := f_loat C
  r := '+ r_/_2 c
  0.0 m_ax l_og 1e-300 m_ax (c * '+ r_/ r) / 1e-300 m_ax r '* t_able r
}

## `d p_roject M`: each row of M projected to d dimensions by a fixed
## matrix of +1 and -1 over the square root of d (random indexing):
## distances and angles between rows are roughly kept. The signs come
## from a hash of each place, the same every run, no chance.
l:p_roject := { d M ->
  n := 2 s_elect s_hape M
  h := 43758.5453 * s_in (12.9898 * f_loat r_ange n) '+ t_able 78.233 * f_loat r_ange d
  M '+ '* i_nner (1.0 - 2.0 * f_loat (h - f_loat f_loor h) < 0.5) / (f_loat d) ^ 0.5
}

### Neighbors

## `u_nit E`: each row scaled to length 1 (a row of 0s stays 0).
l:u_nit := { E ->
  len := (1e-300 m_ax '+ r_/_2 E * E) ^ 0.5
  E / len 'l_eft t_able o_ffsets 2 s_elect s_hape E
}

## `E c_osines i`: the cosine of row i with every row of E.
l:c_osines := { E i -> (l:u_nit E) '+ '* i_nner r_avel i s_elect l:u_nit E }

## `(E, k) n_earest i`: the k rows of E most like row i (by cosine),
## nearest first, row i itself left out.
## >> "em:" u_se< "Embed"
## >> E := 4 2 r_eshape 1.0 0.0 0.9 0.1 0.0 1.0 0.7 0.7
## >> (E, 2) em:n_earest 1
## 2 4
l:n_earest := { (E, k) i ->
  order := g_rade n_eg E l:c_osines i
  k t_ake (order != i) r_eplicate order
}

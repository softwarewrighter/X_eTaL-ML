#!/usr/bin/env xetal
# Net: the training step t_rain< writes is train-live's hand-written
# one (the backprop microscope's gradient and Adam), checked with Check
# after 20 steps on the same spiral from the same start.
"nn:" u_se< "NN"
"net:" u_se< "Net"
"k:" u_se< "Check"
n := 60
i := o_ffsets n
arm := i d_iv 20
t := (0.5 + f_loat i m_od 20) / 20.0
a := (2.0944 * f_loat arm) + 5.5 * t
X := o_\ (2 c_at n) r_eshape ((0.1 + 0.9 * t) * c_os a) c_at (0.1 + 0.9 * t) * s_in a
Y := 3 nn:o_neHot 1 + arm
lr := 0.02
# By hand, as demos/train-live writes it.
u:o_nes := { x -> x c_at_2 ((t_ally x) c_at 1) r_eshape 1.0 }
u:g_rad := { W1 W2 ->
  H := nn:t_anh X nn:d_ense W1
  D2 := ((nn:s_oftmax H nn:d_ense W2) - Y) / f_loat n
  D1 := (D2 '+ '* i_nner o_\ -1 d_rop W2) * 1.0 - H * H
  (e_nclose (o_\ u:o_nes X) '+ '* i_nner D1) c_at e_nclose (o_\ u:o_nes H) '+ '* i_nner D2
}
u:m_ove := { mv k -> ((d_isclose 1 s_elect mv) / 1.0 - 0.9 ^ k) / 0.00000001 + ((d_isclose 2 s_elect mv) / 1.0 - 0.999 ^ k) ^ 0.5 }
u:h_and := { s ->
  W1 := d_isclose 1 s_elect s
  W2 := d_isclose 2 s_elect s
  k := 1.0 + d_isclose 7 s_elect s
  g := W1 u:g_rad W2
  M1 := (0.9 * d_isclose 3 s_elect s) + 0.1 * d_isclose 1 s_elect g
  M2 := (0.9 * d_isclose 4 s_elect s) + 0.1 * d_isclose 2 s_elect g
  V1 := (0.999 * d_isclose 5 s_elect s) + 0.001 * (d_isclose 1 s_elect g) * d_isclose 1 s_elect g
  V2 := (0.999 * d_isclose 6 s_elect s) + 0.001 * (d_isclose 2 s_elect g) * d_isclose 2 s_elect g
  W1 := W1 - lr * ((e_nclose M1) c_at e_nclose V1) u:m_ove k
  W2 := W2 - lr * ((e_nclose M2) c_at e_nclose V2) u:m_ove k
  (e_nclose W1) c_at (e_nclose W2) c_at (e_nclose M1) c_at (e_nclose M2) c_at (e_nclose V1) c_at (e_nclose V2) c_at e_nclose k
}
# By the macro, from the spec.
u:m_acro := { g1:s ->
  g2:W1 := d_isclose 1 s_elect g1:s
  g3:W2 := d_isclose 2 s_elect g1:s
  g4:A0 := X
  g5:A1 := nn:t_anh g4:A0 nn:d_ense g2:W1
  g6:A2 := nn:s_oftmax g5:A1 nn:d_ense g3:W2
  g7:D2 := (g6:A2 - Y) / f_loat t_ally X
  g8:D1 := (g7:D2 '+ '* i_nner o_\ -1 d_rop g3:W2) * 1.0 - g5:A1 * g5:A1
  g9:G1 := (o_\ g4:A0 c_at_2 ((t_ally g4:A0) c_at 1) r_eshape 1.0) '+ '* i_nner g8:D1
  g10:G2 := (o_\ g5:A1 c_at_2 ((t_ally g5:A1) c_at 1) r_eshape 1.0) '+ '* i_nner g7:D2
  g11:k := 1.0 + d_isclose 7 s_elect g1:s
  g12:M1 := (0.9 * d_isclose 3 s_elect g1:s) + 0.1 * g9:G1
  g13:V1 := (0.999 * d_isclose 5 s_elect g1:s) + 0.001 * g9:G1 * g9:G1
  g2:W1 := g2:W1 - lr * (g12:M1 / 1.0 - 0.9 ^ g11:k) / 0.00000001 + (g13:V1 / 1.0 - 0.999 ^ g11:k) ^ 0.5
  g14:M2 := (0.9 * d_isclose 4 s_elect g1:s) + 0.1 * g10:G2
  g15:V2 := (0.999 * d_isclose 6 s_elect g1:s) + 0.001 * g10:G2 * g10:G2
  g3:W2 := g3:W2 - lr * (g14:M2 / 1.0 - 0.9 ^ g11:k) / 0.00000001 + (g15:V2 / 1.0 - 0.999 ^ g11:k) ^ 0.5
  (e_nclose g2:W1) c_at (e_nclose g3:W2) c_at (e_nclose g12:M1) c_at (e_nclose g14:M2) c_at (e_nclose g13:V1) c_at (e_nclose g15:V2) c_at e_nclose g11:k
}
w1 := 3 16 r_eshape 0.31 -0.42 0.17 0.05 -0.28 0.44 -0.13 0.36
w2 := 17 3 r_eshape -0.21 0.33 0.08 -0.39 0.26
s0 := ((e_nclose w1) c_at (e_nclose w2) c_at (e_nclose 0.0 * w1) c_at (e_nclose 0.0 * w2) c_at (e_nclose 0.0 * w1) c_at (e_nclose 0.0 * w2) c_at e_nclose 0.0)
a20 := 20 'u:h_and p_ower s0
b20 := 20 'u:m_acro p_ower s0
u:l_oss := { s -> Y nn:c_rossEntropy nn:s_oftmax (nn:t_anh X nn:d_ense d_isclose 1 s_elect s) nn:d_ense d_isclose 2 s_elect s }
c1 := "W1 as by hand" k:t_est (d_isclose 1 s_elect a20) k:n_ear d_isclose 1 s_elect b20
c2 := "W2 as by hand" k:t_est (d_isclose 2 s_elect a20) k:n_ear d_isclose 2 s_elect b20
c3 := "Adam's averages as by hand" k:t_est (r_avel d_isclose 6 s_elect a20) k:n_ear r_avel d_isclose 6 s_elect b20
c4 := "twenty steps counted" k:t_est 20.0 k:n_ear d_isclose 7 s_elect b20
c5 := "the loss falls" k:t_est k:t_rue (u:l_oss b20) < u:l_oss s0
k:r_eport c1 k:a_nd c2 k:a_nd c3 k:a_nd c4 k:a_nd c5


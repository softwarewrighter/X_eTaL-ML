#!/usr/bin/env xetal
# Flow: every stage's value, as flow:s_tages< gives it for pages that
# show what each stage gives: a record per value (a tuple label's parts
# a record each), its stage's number, label, shape, smallest and
# largest item and first items. Each record is checked against the
# stage computed alone.
"flow:" u_se< "Flow"
"t:" u_se< "Strings"
"k:" u_se< "Check"
X := 3 4 r_eshape 0.1 * f_loat r_ange 12
W := 4 2 r_eshape 1.0 -1.0 0.5 2.0 0.0 1.0 -0.5 0.25
b := 0.1 -0.2
## A labeled stage, an unlabeled one, a scalar at the end.
s1 := ({ @ ->
  g1:stage := X
  p := { @ ->
    it := g1:stage
    it '+ '* i_nner W
  } @
  _ := { @ ->
    ((s_hape p) m_atch r_avel 3 c_at 2) ? @
    "shape" []S_IGNAL "stage 2 (p): shape " c_at (f_ormat s_hape p) c_at ", expected " c_at f_ormat r_avel 3 c_at 2
  } @
  g2:stage := p + 3 2 r_eshape b
  g3:stage := { @ ->
    it := g2:stage
    '+ r_/ r_avel it
  } @
  ("1;;" c_at (f_ormat s_hape g1:stage) c_at ";" c_at (f_ormat 'm_in r_/ r_avel g1:stage)
    c_at ";" c_at (f_ormat 'm_ax r_/ r_avel g1:stage) c_at ";" c_at f_ormat (64 m_in t_ally r_avel g1:stage)
    t_ake r_avel g1:stage) c_at " | " c_at ("2;p;" c_at (f_ormat s_hape p) c_at
    ";" c_at (f_ormat 'm_in r_/ r_avel p) c_at ";" c_at (f_ormat 'm_ax r_/ r_avel p)
    c_at ";" c_at f_ormat (64 m_in t_ally r_avel p) t_ake r_avel p) c_at " | " c_at ("3;;"
    c_at (f_ormat s_hape g2:stage) c_at ";" c_at (f_ormat 'm_in r_/ r_avel g2:stage)
    c_at ";" c_at (f_ormat 'm_ax r_/ r_avel g2:stage) c_at ";" c_at f_ormat (64 m_in t_ally r_avel g2:stage)
    t_ake r_avel g2:stage) c_at " | " c_at ("4;;" c_at (f_ormat s_hape g3:stage)
    c_at ";" c_at (f_ormat 'm_in r_/ r_avel g3:stage) c_at ";" c_at (f_ormat 'm_ax r_/ r_avel g3:stage)
    c_at ";" c_at f_ormat (64 m_in t_ally r_avel g3:stage) t_ake r_avel g3:stage)
} @)
s1
r := " | " t:s_plit s1
u:f_ields := { i -> ";" t:s_plit d_isclose i s_elect r }
c1 := "a record per stage, the data first" k:t_est 4 k:i_s t_ally r
c2 := "the data, its shape and range" k:t_est ("1" "" "3 4" "0.1" "1.2000000000000002") k:i_s 5 t_ake u:f_ields 1
c3 := "a labeled stage, its values those of the stage alone" k:t_est (d_isclose 6 s_elect u:f_ields 2) k:i_s f_ormat r_avel X '+ '* i_nner W
c4 := "a scalar has an empty shape" k:t_est ("4" "" "") k:i_s 3 t_ake u:f_ields 4
c5 := "the last value is the pipeline's" k:t_est (d_isclose 6 s_elect u:f_ields 4) k:i_s f_ormat ({ @ ->
  g4:stage := X
  p := { @ ->
    it := g4:stage
    it '+ '* i_nner W
  } @
  _ := { @ ->
    ((s_hape p) m_atch r_avel 3 c_at 2) ? @
    "shape" []S_IGNAL "stage 2 (p): shape " c_at (f_ormat s_hape p) c_at ", expected " c_at f_ormat r_avel 3 c_at 2
  } @
  g5:stage := p + 3 2 r_eshape b
  g6:stage := { @ ->
    it := g5:stage
    '+ r_/ r_avel it
  } @
  g6:stage
} @)
## A tuple label: a record per part.
s2 := ({ @ ->
  g7:stage := X
  (Q, K) := { @ ->
    it := g7:stage
    (it '+ '* i_nner W, 2.0 * it '+ '* i_nner W)
  } @
  g8:stage := K - Q
  ("1;;" c_at (f_ormat s_hape g7:stage) c_at ";" c_at (f_ormat 'm_in r_/ r_avel g7:stage)
    c_at ";" c_at (f_ormat 'm_ax r_/ r_avel g7:stage) c_at ";" c_at f_ormat (64 m_in t_ally r_avel g7:stage)
    t_ake r_avel g7:stage) c_at " | " c_at ("2;Q;" c_at (f_ormat s_hape Q) c_at
    ";" c_at (f_ormat 'm_in r_/ r_avel Q) c_at ";" c_at (f_ormat 'm_ax r_/ r_avel Q)
    c_at ";" c_at f_ormat (64 m_in t_ally r_avel Q) t_ake r_avel Q) c_at " | " c_at ("2;K;"
    c_at (f_ormat s_hape K) c_at ";" c_at (f_ormat 'm_in r_/ r_avel K) c_at ";"
    c_at (f_ormat 'm_ax r_/ r_avel K) c_at ";" c_at f_ormat (64 m_in t_ally r_avel K)
    t_ake r_avel K) c_at " | " c_at ("3;;" c_at (f_ormat s_hape g8:stage) c_at
    ";" c_at (f_ormat 'm_in r_/ r_avel g8:stage) c_at ";" c_at (f_ormat 'm_ax r_/ r_avel g8:stage)
    c_at ";" c_at f_ormat (64 m_in t_ally r_avel g8:stage) t_ake r_avel g8:stage)
} @)
q := " | " t:s_plit s2
c6 := "a tuple's parts, a record each" k:t_est ("2;Q" "2;K") k:i_s '{ i -> 3 t_ake d_isclose i s_elect q } m_ap 2 3
## At most 64 items are given.
s3 := ({ @ ->
  g9:stage := f_loat r_ange 100
  g10:stage := { @ ->
    it := g9:stage
    2.0 * it
  } @
  ("1;;" c_at (f_ormat s_hape g9:stage) c_at ";" c_at (f_ormat 'm_in r_/ r_avel g9:stage)
    c_at ";" c_at (f_ormat 'm_ax r_/ r_avel g9:stage) c_at ";" c_at f_ormat (64 m_in t_ally r_avel g9:stage)
    t_ake r_avel g9:stage) c_at " | " c_at ("2;;" c_at (f_ormat s_hape g10:stage)
    c_at ";" c_at (f_ormat 'm_in r_/ r_avel g10:stage) c_at ";" c_at (f_ormat 'm_ax r_/ r_avel g10:stage)
    c_at ";" c_at f_ormat (64 m_in t_ally r_avel g10:stage) t_ake r_avel
    g10:stage)
} @)
c7 := "64 items at most" k:t_est 64 k:i_s t_ally t:w_ords d_isclose 6 s_elect ";" t:s_plit d_isclose 1 s_elect " | " t:s_plit s3
k:r_eport c1 k:a_nd c2 k:a_nd c3 k:a_nd c4 k:a_nd c5 k:a_nd c6 k:a_nd c7


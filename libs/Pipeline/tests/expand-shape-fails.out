#!/usr/bin/env xetal
# Pipeline: a shape annotation the value does not meet stops the program, naming the stage, its shape and the one expected.
"pipe:" u_se< "Pipeline"
x := f_loat 1 2 3 4
n := 3
{ @ ->
  g1:stage := x
  y := { @ ->
    it := g1:stage
    2 * it
  } @
  _ := { @ ->
    ((s_hape y) m_atch r_avel n) ? @
    "shape" []S_IGNAL "stage 2 (y): shape " c_at (f_ormat s_hape y) c_at ", expected " c_at f_ormat r_avel n
  } @
  g2:stage := y + 1
  g2:stage
} @


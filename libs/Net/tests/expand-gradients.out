#!/usr/bin/env xetal
# Net: the gradients g_radient< writes equal finite differences, for
# networks of every activation word, checked with Check.
"nn:" u_se< "NN"
"act:" u_se< "Activations"
"net:" u_se< "Net"
"k:" u_se< "Check"
X := 5 3 r_eshape 0.3 -0.7 1.1 0.0 2.0 -1.5 0.9 0.4
Y := 3 nn:o_neHot 1 3 2 2 1
w1 := 4 5 r_eshape 0.5 -1.0 0.25 2.0 0.0 -0.5 1.0 1.5 -2.0 0.1 0.2 0.3 -0.4
w2 := 6 4 r_eshape 1.0 -1.0 0.5 0.5 -0.25 2.0 0.0 0.1 0.7
w3 := 5 3 r_eshape 0.2 -0.6 0.9 -0.1 0.4
v1 := 4 3 r_eshape 0.8 -0.3 0.5 0.1 -0.9
u:g_a := { (g1:W1, g2:W2, g3:W3) ->
  g4:A0 := X
  g5:A1 := act:r_elu g4:A0 nn:d_ense g1:W1
  g6:A2 := act:s_igmoid g5:A1 nn:d_ense g2:W2
  g7:A3 := nn:s_oftmax g6:A2 nn:d_ense g3:W3
  g10:D3 := (g7:A3 - Y) / f_loat t_ally X
  g9:D2 := (g10:D3 '+ '* i_nner o_\ -1 d_rop g3:W3) * g6:A2 * 1.0 - g6:A2
  g8:D1 := (g9:D2 '+ '* i_nner o_\ -1 d_rop g2:W2) * f_loat g5:A1 > 0.0
  g11:G1 := (o_\ g4:A0 c_at_2 ((t_ally g4:A0) c_at 1) r_eshape 1.0) '+ '* i_nner g8:D1
  g12:G2 := (o_\ g5:A1 c_at_2 ((t_ally g5:A1) c_at 1) r_eshape 1.0) '+ '* i_nner g9:D2
  g13:G3 := (o_\ g6:A2 c_at_2 ((t_ally g6:A2) c_at 1) r_eshape 1.0) '+ '* i_nner g10:D3
  (g11:G1, g12:G2, g13:G3)
}
u:g_b := { (g14:W1, g15:W2, g16:W3) ->
  g17:A0 := X
  g18:A1 := act:t_anh g17:A0 nn:d_ense g14:W1
  g19:A2 := g18:A1 nn:d_ense g15:W2
  g20:A3 := nn:s_oftmax g19:A2 nn:d_ense g16:W3
  g23:D3 := (g20:A3 - Y) / f_loat t_ally X
  g22:D2 := (g23:D3 '+ '* i_nner o_\ -1 d_rop g16:W3)
  g21:D1 := (g22:D2 '+ '* i_nner o_\ -1 d_rop g15:W2) * 1.0 - g18:A1 * g18:A1
  g24:G1 := (o_\ g17:A0 c_at_2 ((t_ally g17:A0) c_at 1) r_eshape 1.0) '+ '* i_nner g21:D1
  g25:G2 := (o_\ g18:A1 c_at_2 ((t_ally g18:A1) c_at 1) r_eshape 1.0) '+ '* i_nner g22:D2
  g26:G3 := (o_\ g19:A2 c_at_2 ((t_ally g19:A2) c_at 1) r_eshape 1.0) '+ '* i_nner g23:D3
  (g24:G1, g25:G2, g26:G3)
}
u:g_c := { g27:W1 ->
  g28:A0 := X
  g29:A1 := nn:s_oftmax g28:A0 nn:d_ense g27:W1
  g30:D1 := (g29:A1 - Y) / f_loat t_ally X
  g31:G1 := (o_\ g28:A0 c_at_2 ((t_ally g28:A0) c_at 1) r_eshape 1.0) '+ '* i_nner g30:D1
  g31:G1
}
# The smooth ones: their slopes are Activations' derivatives of the
# dense layer before them.
u:g_d := { (g32:W1, g33:W2, g34:W3) ->
  g35:A0 := X
  g36:A1 := act:g_elu g35:A0 nn:d_ense g32:W1
  g37:A2 := act:m_ish g36:A1 nn:d_ense g33:W2
  g38:A3 := nn:s_oftmax g37:A2 nn:d_ense g34:W3
  g41:D3 := (g38:A3 - Y) / f_loat t_ally X
  g40:D2 := (g41:D3 '+ '* i_nner o_\ -1 d_rop g34:W3) * act:d_mish g36:A1 nn:d_ense g33:W2
  g39:D1 := (g40:D2 '+ '* i_nner o_\ -1 d_rop g33:W2) * act:d_gelu g35:A0 nn:d_ense g32:W1
  g42:G1 := (o_\ g35:A0 c_at_2 ((t_ally g35:A0) c_at 1) r_eshape 1.0) '+ '* i_nner g39:D1
  g43:G2 := (o_\ g36:A1 c_at_2 ((t_ally g36:A1) c_at 1) r_eshape 1.0) '+ '* i_nner g40:D2
  g44:G3 := (o_\ g37:A2 c_at_2 ((t_ally g37:A2) c_at 1) r_eshape 1.0) '+ '* i_nner g41:D3
  (g42:G1, g43:G2, g44:G3)
}
u:g_e := { (g45:W1, g46:W2, g47:W3) ->
  g48:A0 := X
  g49:A1 := act:s_ilu g48:A0 nn:d_ense g45:W1
  g50:A2 := act:s_oftplus g49:A1 nn:d_ense g46:W2
  g51:A3 := nn:s_oftmax g50:A2 nn:d_ense g47:W3
  g54:D3 := (g51:A3 - Y) / f_loat t_ally X
  g53:D2 := (g54:D3 '+ '* i_nner o_\ -1 d_rop g47:W3) * act:d_softplus g49:A1 nn:d_ense g46:W2
  g52:D1 := (g53:D2 '+ '* i_nner o_\ -1 d_rop g46:W2) * act:d_silu g48:A0 nn:d_ense g45:W1
  g55:G1 := (o_\ g48:A0 c_at_2 ((t_ally g48:A0) c_at 1) r_eshape 1.0) '+ '* i_nner g52:D1
  g56:G2 := (o_\ g49:A1 c_at_2 ((t_ally g49:A1) c_at 1) r_eshape 1.0) '+ '* i_nner g53:D2
  g57:G3 := (o_\ g50:A2 c_at_2 ((t_ally g50:A2) c_at 1) r_eshape 1.0) '+ '* i_nner g54:D3
  (g55:G1, g56:G2, g57:G3)
}
u:g_f := { (g58:W1, g59:W2, g60:W3) ->
  g61:A0 := X
  g62:A1 := act:s_elu g61:A0 nn:d_ense g58:W1
  g63:A2 := act:h_ardSwish g62:A1 nn:d_ense g59:W2
  g64:A3 := nn:s_oftmax g63:A2 nn:d_ense g60:W3
  g67:D3 := (g64:A3 - Y) / f_loat t_ally X
  g66:D2 := (g67:D3 '+ '* i_nner o_\ -1 d_rop g60:W3) * act:d_hardSwish g62:A1 nn:d_ense g59:W2
  g65:D1 := (g66:D2 '+ '* i_nner o_\ -1 d_rop g59:W2) * act:d_selu g61:A0 nn:d_ense g58:W1
  g68:G1 := (o_\ g61:A0 c_at_2 ((t_ally g61:A0) c_at 1) r_eshape 1.0) '+ '* i_nner g65:D1
  g69:G2 := (o_\ g62:A1 c_at_2 ((t_ally g62:A1) c_at 1) r_eshape 1.0) '+ '* i_nner g66:D2
  g70:G3 := (o_\ g63:A2 c_at_2 ((t_ally g63:A2) c_at 1) r_eshape 1.0) '+ '* i_nner g67:D3
  (g68:G1, g69:G2, g70:G3)
}
# The loss of weights w (a tuple) for each network.
u:l_a := { (a, b, c) -> Y nn:c_rossEntropy nn:s_oftmax (act:s_igmoid (act:r_elu X nn:d_ense a) nn:d_ense b) nn:d_ense c }
u:l_b := { (a, b, c) -> Y nn:c_rossEntropy nn:s_oftmax ((act:t_anh X nn:d_ense a) nn:d_ense b) nn:d_ense c }
u:l_c := { a -> Y nn:c_rossEntropy nn:s_oftmax X nn:d_ense a }
u:l_d := { (a, b, c) -> Y nn:c_rossEntropy nn:s_oftmax (act:m_ish (act:g_elu X nn:d_ense a) nn:d_ense b) nn:d_ense c }
u:l_e := { (a, b, c) -> Y nn:c_rossEntropy nn:s_oftmax (act:s_oftplus (act:s_ilu X nn:d_ense a) nn:d_ense b) nn:d_ense c }
u:l_f := { (a, b, c) -> Y nn:c_rossEntropy nn:s_oftmax (act:h_ardSwish (act:s_elu X nn:d_ense a) nn:d_ense b) nn:d_ense c }
# e at item i of an array shaped as w, 0 elsewhere.
e := 0.00001
u:b_ump := { w i -> e * f_loat (s_hape w) r_eshape i = r_ange t_ally r_avel w }
u:g_ap := { g f -> 'm_ax r_/ r_avel a_bs g - f }
# Each layer's finite differences, (L(w + e) - L(w - e)) / 2e per item.
(A1, A2, A3) := u:g_a (w1, w2, w3)
FA1 := (s_hape w1) r_eshape '{ i -> ((u:l_a (w1 + w1 u:b_ump i, w2, w3)) - u:l_a (w1 - w1 u:b_ump i, w2, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w1
FA2 := (s_hape w2) r_eshape '{ i -> ((u:l_a (w1, w2 + w2 u:b_ump i, w3)) - u:l_a (w1, w2 - w2 u:b_ump i, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w2
FA3 := (s_hape w3) r_eshape '{ i -> ((u:l_a (w1, w2, w3 + w3 u:b_ump i)) - u:l_a (w1, w2, w3 - w3 u:b_ump i)) / 2.0 * e } e_ach r_ange t_ally r_avel w3
(B1, B2, B3) := u:g_b (w1, w2, w3)
FB1 := (s_hape w1) r_eshape '{ i -> ((u:l_b (w1 + w1 u:b_ump i, w2, w3)) - u:l_b (w1 - w1 u:b_ump i, w2, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w1
FB2 := (s_hape w2) r_eshape '{ i -> ((u:l_b (w1, w2 + w2 u:b_ump i, w3)) - u:l_b (w1, w2 - w2 u:b_ump i, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w2
FB3 := (s_hape w3) r_eshape '{ i -> ((u:l_b (w1, w2, w3 + w3 u:b_ump i)) - u:l_b (w1, w2, w3 - w3 u:b_ump i)) / 2.0 * e } e_ach r_ange t_ally r_avel w3
(D1, D2, D3) := u:g_d (w1, w2, w3)
FD1 := (s_hape w1) r_eshape '{ i -> ((u:l_d (w1 + w1 u:b_ump i, w2, w3)) - u:l_d (w1 - w1 u:b_ump i, w2, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w1
FD2 := (s_hape w2) r_eshape '{ i -> ((u:l_d (w1, w2 + w2 u:b_ump i, w3)) - u:l_d (w1, w2 - w2 u:b_ump i, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w2
FD3 := (s_hape w3) r_eshape '{ i -> ((u:l_d (w1, w2, w3 + w3 u:b_ump i)) - u:l_d (w1, w2, w3 - w3 u:b_ump i)) / 2.0 * e } e_ach r_ange t_ally r_avel w3
(E1, E2, E3) := u:g_e (w1, w2, w3)
FE1 := (s_hape w1) r_eshape '{ i -> ((u:l_e (w1 + w1 u:b_ump i, w2, w3)) - u:l_e (w1 - w1 u:b_ump i, w2, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w1
FE2 := (s_hape w2) r_eshape '{ i -> ((u:l_e (w1, w2 + w2 u:b_ump i, w3)) - u:l_e (w1, w2 - w2 u:b_ump i, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w2
FE3 := (s_hape w3) r_eshape '{ i -> ((u:l_e (w1, w2, w3 + w3 u:b_ump i)) - u:l_e (w1, w2, w3 - w3 u:b_ump i)) / 2.0 * e } e_ach r_ange t_ally r_avel w3
(F1, F2, F3) := u:g_f (w1, w2, w3)
FF1 := (s_hape w1) r_eshape '{ i -> ((u:l_f (w1 + w1 u:b_ump i, w2, w3)) - u:l_f (w1 - w1 u:b_ump i, w2, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w1
FF2 := (s_hape w2) r_eshape '{ i -> ((u:l_f (w1, w2 + w2 u:b_ump i, w3)) - u:l_f (w1, w2 - w2 u:b_ump i, w3)) / 2.0 * e } e_ach r_ange t_ally r_avel w2
FF3 := (s_hape w3) r_eshape '{ i -> ((u:l_f (w1, w2, w3 + w3 u:b_ump i)) - u:l_f (w1, w2, w3 - w3 u:b_ump i)) / 2.0 * e } e_ach r_ange t_ally r_avel w3
C1 := u:g_c v1
FC1 := (s_hape v1) r_eshape '{ i -> ((u:l_c v1 + v1 u:b_ump i) - u:l_c v1 - v1 u:b_ump i) / 2.0 * e } e_ach r_ange t_ally r_avel v1
c1 := "relu, sigmoid, softmax" k:t_est k:t_rue 0.0000001 > (A1 u:g_ap FA1) m_ax (A2 u:g_ap FA2) m_ax A3 u:g_ap FA3
c2 := "tanh, none, softmax" k:t_est k:t_rue 0.0000001 > (B1 u:g_ap FB1) m_ax (B2 u:g_ap FB2) m_ax B3 u:g_ap FB3
c3 := "one layer, softmax: one array in, one out" k:t_est k:t_rue 0.0000001 > C1 u:g_ap FC1
c4 := "each gradient has its weights' shape" k:t_est ((s_hape w1) c_at (s_hape w2) c_at s_hape w3) k:i_s (s_hape A1) c_at (s_hape A2) c_at s_hape A3
c5 := "gelu, mish, softmax" k:t_est k:t_rue 0.0000001 > (D1 u:g_ap FD1) m_ax (D2 u:g_ap FD2) m_ax D3 u:g_ap FD3
c6 := "silu, softplus, softmax" k:t_est k:t_rue 0.0000001 > (E1 u:g_ap FE1) m_ax (E2 u:g_ap FE2) m_ax E3 u:g_ap FE3
c7 := "selu, hardSwish, softmax" k:t_est k:t_rue 0.0000001 > (F1 u:g_ap FF1) m_ax (F2 u:g_ap FF2) m_ax F3 u:g_ap FF3
k:r_eport c1 k:a_nd c2 k:a_nd c3 k:a_nd c4 k:a_nd c5 k:a_nd c6 k:a_nd c7


#!/usr/bin/env xetal
## lo:a_dapter< trains d and b of VeRA's five arrays, never its frozen
## projections: "train A B" on five arrays is refused.
"lo:" u_se< "LoRA"
W := 2 2 r_eshape 1.0 0.0 0.0 1.0
A := 1 2 r_eshape 1.0 1.0
B := 2 1 r_eshape 1.0 -1.0
d := 1 r_eshape 0.5
b := 2.0 4.0
"u:f_wd u:b_wd" lo:a_dapter< "W A B d b | r 1 | train A B"

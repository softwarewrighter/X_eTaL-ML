#!/usr/bin/env xetal
## Pipelines of equations: stages that are Equations calls, each
## reading the arrays it names (the previous value as it, earlier ones
## by their labels), then the same layer by the libraries, a check that
## they agree, and the pipeline drawn as math by flow:m_ath<: a row a
## stage, an arrow carrying each value's name and shape, the equations
## as Equations draws them. `xetal expand equations.xtl` shows what
## each pipeline became.

"flow:" u_se< "Flow"
"e:" u_se< "Equations"
"nn:" u_se< "NN"
"act:" u_se< "Activations"
"nm:" u_se< "Norm"
"at:" u_se< "Attention"
"k:" u_se< "Check"

### Data

## Four tokens of three features, and small fixed weights.
n := 4
X := 4 3 r_eshape 0.5 * s_in f_loat r_ange 12
Wq := 3 2 r_eshape 0.4 * c_os f_loat r_ange 6
Wk := 3 2 r_eshape 0.4 * s_in 2.0 * f_loat r_ange 6
Wv := 3 2 r_eshape 0.6 * c_os 3.0 * f_loat r_ange 6

### Attention as equations

## One head of attention written as the paper writes it, a stage an
## equation: the queries from the data (it), the keys and values from
## it too, by its label x; the scores of each query against each key,
## the softmax of each row written out, the values weighted. The
## pipeline fans out from x and in at the scores and the last stage.
head := @ flow:p_ipe< c#"
   X $x
|> "Q[i,d] | n 2" e:e_q< "sum c:=0..2 | x[i,c] * Wq[c,d]" $q
|> "K[j,d] | n 2" e:e_q< "sum c:=0..2 | x[j,c] * Wk[c,d]" $k
|> "V[j,d] | n 2" e:e_q< "sum c:=0..2 | x[j,c] * Wv[c,d]" $v
|> "S[i,j] | n n" e:e_q< "(sum d:=0..1 | q[i,d] * k[j,d]) / sqrt(2.0)" $s [n n]
|> "A[i,j] | n n" e:e_q< "exp(s[i,j]) / (sum m:=0..n-1 | exp(s[i,m]))" $a
|> "Y[i,d] | n 2" e:e_q< "sum j:=0..n-1 | a[i,j] * v[j,d]""#
drawn := @ flow:m_ath< c#"
   X $x
|> "Q[i,d] | n 2" e:e_q< "sum c:=0..2 | x[i,c] * Wq[c,d]" $q
|> "K[j,d] | n 2" e:e_q< "sum c:=0..2 | x[j,c] * Wk[c,d]" $k
|> "V[j,d] | n 2" e:e_q< "sum c:=0..2 | x[j,c] * Wv[c,d]" $v
|> "S[i,j] | n n" e:e_q< "(sum d:=0..1 | q[i,d] * k[j,d]) / sqrt(2.0)" $s [n n]
|> "A[i,j] | n n" e:e_q< "exp(s[i,j]) / (sum m:=0..n-1 | exp(s[i,m]))" $a
|> "Y[i,d] | n 2" e:e_q< "sum j:=0..n-1 | a[i,j] * v[j,d]""#
drawn
head0 := (Wq, Wk, Wv) at:h_ead (X, at:a_ll n)
r1 := "the equations are Attention's head, every token seeing every token" k:t_est head k:n_ear head0

### A BERT layer

## One encoder layer of BERT (Tiny BERT, demos/micro-bert, applies two
## of them to letters): the attention (here Attention's own head), out
## through Wo, added back to the input (its label h) and layer-normed;
## the GELU feed-forward layer, added back (a) and layer-normed. The
## shapes are checked as it runs. Made-up weights; one head of width 3.
Wo := 3 3 r_eshape 0.3 * c_os 2.0 * f_loat r_ange 9
Bq := 3 3 r_eshape 0.4 * s_in 3.0 * f_loat r_ange 9
W1 := 4 6 r_eshape 0.3 * s_in f_loat r_ange 24
W2 := 7 3 r_eshape 0.3 * c_os f_loat r_ange 21
g := 1.0 1.0 1.0
c := 0.0 0.0 0.0
layer := @ flow:p_ipe< c#"
   X $h
|> (Bq, Bq, Bq) at:h_ead (it, at:a_ll n)
|> it '+ '* i_nner Wo
|> (g, c) nm:l_ayer it + h $a [n 3]
|> act:g_elu it nn:d_ense W1
|> it nn:d_ense W2
|> (g, c) nm:l_ayer it + a $out [n 3]"#
shown := @ flow:m_ath< c#"
   X $h
|> (Bq, Bq, Bq) at:h_ead (it, at:a_ll n)
|> it '+ '* i_nner Wo
|> (g, c) nm:l_ayer it + h $a [n 3]
|> act:g_elu it nn:d_ense W1
|> it nn:d_ense W2
|> (g, c) nm:l_ayer it + a $out [n 3]"#
shown
a0 := (g, c) nm:l_ayer X + ((Bq, Bq, Bq) at:h_ead (X, at:a_ll n)) '+ '* i_nner Wo
layer0 := (g, c) nm:l_ayer a0 + (act:g_elu a0 nn:d_ense W1) nn:d_ense W2
r2 := "the pipeline is the layer written out" k:t_est layer k:n_ear layer0

k:r_eport r1 k:a_nd r2

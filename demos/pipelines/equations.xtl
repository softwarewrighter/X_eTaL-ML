#!/usr/bin/env xetal
## Pipelines of equations: stages that are Equations calls, each
## reading the arrays it names (the previous value as it, earlier ones
## by their labels), then the same layer by the libraries, a check that
## they agree, and the pipeline drawn as math by flow:m_ath<: a row a
## stage, an arrow carrying each value's name and shape, the equations
## as Equations draws them. `xetal expand equations.xtl` shows what
## each pipeline became.

"flow:" u_se< "Flow"
"e:" u_se< "Equations"
"nn:" u_se< "NN"
"act:" u_se< "Activations"
"nm:" u_se< "Norm"
"at:" u_se< "Attention"
"k:" u_se< "Check"

### Data

## Four tokens of three features, and small fixed weights.
n := 4
X := 4 3 r_eshape 0.5 * s_in f_loat r_ange 12
Wq := 3 2 r_eshape 0.4 * c_os f_loat r_ange 6
Wk := 3 2 r_eshape 0.4 * s_in 2.0 * f_loat r_ange 6
Wv := 3 2 r_eshape 0.6 * c_os 3.0 * f_loat r_ange 6

### Attention as equations

## One head of attention written as the paper writes it, a stage an
## equation: the queries from the data (it), the keys and values from
## it too, by its label x; the scores of each query against each key,
## the softmax of each row written out, the values weighted. The
## pipeline fans out from x and in at the scores and the last stage.
head := @ flow:p_ipe< c#"
   X $x
|> "Q[i,d] | n 2" e:e_q< "sum c:=0..2 | x[i,c] * Wq[c,d]" $q
|> "K[j,d] | n 2" e:e_q< "sum c:=0..2 | x[j,c] * Wk[c,d]" $k
|> "V[j,d] | n 2" e:e_q< "sum c:=0..2 | x[j,c] * Wv[c,d]" $v
|> "S[i,j] | n n" e:e_q< "(sum d:=0..1 | q[i,d] * k[j,d]) / sqrt(2.0)" $s [n n]
|> "A[i,j] | n n" e:e_q< "exp(s[i,j]) / (sum m:=0..n-1 | exp(s[i,m]))" $a
|> "Y[i,d] | n 2" e:e_q< "sum j:=0..n-1 | a[i,j] * v[j,d]""#
drawn := @ flow:m_ath< c#"
   X $x
|> "Q[i,d] | n 2" e:e_q< "sum c:=0..2 | x[i,c] * Wq[c,d]" $q
|> "K[j,d] | n 2" e:e_q< "sum c:=0..2 | x[j,c] * Wk[c,d]" $k
|> "V[j,d] | n 2" e:e_q< "sum c:=0..2 | x[j,c] * Wv[c,d]" $v
|> "S[i,j] | n n" e:e_q< "(sum d:=0..1 | q[i,d] * k[j,d]) / sqrt(2.0)" $s [n n]
|> "A[i,j] | n n" e:e_q< "exp(s[i,j]) / (sum m:=0..n-1 | exp(s[i,m]))" $a
|> "Y[i,d] | n 2" e:e_q< "sum j:=0..n-1 | a[i,j] * v[j,d]""#
drawn
head0 := (Wq, Wk, Wv) at:h_ead (X, at:a_ll n)
r1 := "the equations are Attention's head, every token seeing every token" k:t_est head k:n_ear head0

### A BERT layer

## One encoder layer of BERT (Tiny BERT, demos/micro-bert, applies two
## of them to letters), every stage an equation: one head of attention
## (queries, keys and values from the input h, the scores, the softmax,
## the values weighted), out through Wo and added back to h; layer norm
## (each row's mean and variance, then normalized, times the gain g,
## plus beta); the feed-forward layer, a dense layer (its bias the last
## row of W1), GELU, a dense layer added back to y, and layer norm
## again. GELU is its tanh form written with exp, f / (1 + e^(-2u)) for
## u = sqrt(2/pi) (f + 0.044715 f^3), which is Activations' g_elu (the
## grammar has no tanh: ask E6). Checked against the layer written out
## with the libraries; made-up weights, one head of width 3.
Bq := 3 3 r_eshape 0.4 * s_in 3.0 * f_loat r_ange 9
Bk := 3 3 r_eshape 0.4 * c_os 3.0 * f_loat r_ange 9
Bv := 3 3 r_eshape 0.5 * s_in 2.0 * f_loat r_ange 9
Wo := 3 3 r_eshape 0.3 * c_os 2.0 * f_loat r_ange 9
W1 := 4 6 r_eshape 0.3 * s_in f_loat r_ange 24
W2 := 7 3 r_eshape 0.3 * c_os f_loat r_ange 21
g := 1.0 0.9 1.1
beta := 0.1 0.0 -0.1
layer := @ flow:p_ipe< c#"
   X $h
|> "Q[i,d] | n 3" e:e_q< "sum c:=0..2 | h[i,c] * Bq[c,d]" $q
|> "K[j,d] | n 3" e:e_q< "sum c:=0..2 | h[j,c] * Bk[c,d]" $k
|> "V[j,d] | n 3" e:e_q< "sum c:=0..2 | h[j,c] * Bv[c,d]" $v
|> "S[i,j] | n n" e:e_q< "(sum d:=0..2 | q[i,d] * k[j,d]) / sqrt(3.0)" $s
|> "A[i,j] | n n" e:e_q< "exp(s[i,j]) / (sum m:=0..n-1 | exp(s[i,m]))" $a
|> "Z[i,d] | n 3" e:e_q< "sum j:=0..n-1 | a[i,j] * v[j,d]" $z
|> "R[i,c] | n 3" e:e_q< "h[i,c] + (sum d:=0..2 | z[i,d] * Wo[d,c])" $r
|> "Mean[i] | n" e:e_q< "(sum c:=0..2 | r[i,c]) / 3.0" $mu
|> "Var[i] | n" e:e_q< "(sum c:=0..2 | (r[i,c] - mu[i])^2) / 3.0" $var
|> "N[i,c] | n 3" e:e_q< "g[c] * (r[i,c] - mu[i]) / sqrt(var[i] + 0.00001) + beta[c]" $y [n 3]
|> "F[i,k] | n 6" e:e_q< "(sum c:=0..2 | y[i,c] * W1[c,k]) + W1[3,k]" $f
|> "U[i,k] | n 6" e:e_q< "0.7978845608028654 * (f[i,k] + 0.044715 * f[i,k]^3)" $u
|> "G[i,k] | n 6" e:e_q< "f[i,k] / (1 + exp(-2 * u[i,k]))" $gl
|> "P[i,c] | n 3" e:e_q< "y[i,c] + (sum k:=0..5 | gl[i,k] * W2[k,c]) + W2[6,c]" $p
|> "Mean[i] | n" e:e_q< "(sum c:=0..2 | p[i,c]) / 3.0" $mu2
|> "Var[i] | n" e:e_q< "(sum c:=0..2 | (p[i,c] - mu2[i])^2) / 3.0" $var2
|> "O[i,c] | n 3" e:e_q< "g[c] * (p[i,c] - mu2[i]) / sqrt(var2[i] + 0.00001) + beta[c]" $out [n 3]"#
shown := @ flow:m_ath< c#"
   X $h
|> "Q[i,d] | n 3" e:e_q< "sum c:=0..2 | h[i,c] * Bq[c,d]" $q
|> "K[j,d] | n 3" e:e_q< "sum c:=0..2 | h[j,c] * Bk[c,d]" $k
|> "V[j,d] | n 3" e:e_q< "sum c:=0..2 | h[j,c] * Bv[c,d]" $v
|> "S[i,j] | n n" e:e_q< "(sum d:=0..2 | q[i,d] * k[j,d]) / sqrt(3.0)" $s
|> "A[i,j] | n n" e:e_q< "exp(s[i,j]) / (sum m:=0..n-1 | exp(s[i,m]))" $a
|> "Z[i,d] | n 3" e:e_q< "sum j:=0..n-1 | a[i,j] * v[j,d]" $z
|> "R[i,c] | n 3" e:e_q< "h[i,c] + (sum d:=0..2 | z[i,d] * Wo[d,c])" $r
|> "Mean[i] | n" e:e_q< "(sum c:=0..2 | r[i,c]) / 3.0" $mu
|> "Var[i] | n" e:e_q< "(sum c:=0..2 | (r[i,c] - mu[i])^2) / 3.0" $var
|> "N[i,c] | n 3" e:e_q< "g[c] * (r[i,c] - mu[i]) / sqrt(var[i] + 0.00001) + beta[c]" $y [n 3]
|> "F[i,k] | n 6" e:e_q< "(sum c:=0..2 | y[i,c] * W1[c,k]) + W1[3,k]" $f
|> "U[i,k] | n 6" e:e_q< "0.7978845608028654 * (f[i,k] + 0.044715 * f[i,k]^3)" $u
|> "G[i,k] | n 6" e:e_q< "f[i,k] / (1 + exp(-2 * u[i,k]))" $gl
|> "P[i,c] | n 3" e:e_q< "y[i,c] + (sum k:=0..5 | gl[i,k] * W2[k,c]) + W2[6,c]" $p
|> "Mean[i] | n" e:e_q< "(sum c:=0..2 | p[i,c]) / 3.0" $mu2
|> "Var[i] | n" e:e_q< "(sum c:=0..2 | (p[i,c] - mu2[i])^2) / 3.0" $var2
|> "O[i,c] | n 3" e:e_q< "g[c] * (p[i,c] - mu2[i]) / sqrt(var2[i] + 0.00001) + beta[c]" $out [n 3]"#
shown
a0 := (g, beta) nm:l_ayer X + ((Bq, Bk, Bv) at:h_ead (X, at:a_ll n)) '+ '* i_nner Wo
layer0 := (g, beta) nm:l_ayer a0 + (act:g_elu a0 nn:d_ense W1) nn:d_ense W2
r2 := "the equations are the layer written out" k:t_est layer k:n_ear layer0

k:r_eport r1 k:a_nd r2

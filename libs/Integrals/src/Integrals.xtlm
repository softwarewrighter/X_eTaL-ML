## Integrals: a definite integral written as a paper prints it, computed by a quadrature rule -- "integral tau:=a..b by trapezoid 64 | body"
##
## Import it with an alias of your choice: "integ:" u_se< "Integrals".
## Put libs/Integrals/src on XETAL_PATH ("just path"); the reference is libs/Integrals/docs.
## Names with m: are macros; those under h: are private to this file.
##
## A macro is a function from the source text written left and right of
## its call to the source that replaces the call, before the program is
## compiled (X_eTaL MC10); xetal expand FILE shows the result. The call
## is X_eTaL's Saga 42 shape (its decisions 2 to 4, 2026-10-17): integral
## read like sum, the rule and the grid as option words with a documented
## default, improper integrals refused. Its reader uses all of its text
## or refuses it. Decision 1 puts integral in X_eTaL-libraries' Equations
## in the end; this library is the same call standing alone, lifted
## whole when that lands (the body here is X_eTaL, there the equation
## grammar).

"t:" u_se< "Strings"

### The macros

## The value of a definite integral by a quadrature rule: "integral
## tau:=a..b by trapezoid 64 | body". The variable and its bounds (any
## X_eTaL giving a Float; a whole-number literal is made Float), then
## the rule (trapezoid or simpson) and the grid (how many steps; simpson
## needs an even number), then | and the body: X_eTaL over the variable,
## which the macro binds to the grid's points as one vector, a, a + h,
## ..., b, so the body is evaluated once for the whole grid. Without
## "by" the rule is trapezoid 64. A bound of inf is refused: write a
## truncation (0..20) and show the tail is small, or change variables.
## Trapezoid is exact on lines, simpson on cubics; at a jump of the
## body the sample takes the body's value at that point as written.
## >> "integ:" u_se< "Integrals"
## >> @ integ:i_ntegral< "integral x:=0..1 by simpson 2 | x ^ 2"
## 0.3333333333333333
m:i_ntegral< := { @ text -> h:w_rite h:r_ead text }

## The LaTeX of the same call, a string: \int_{a}^{b} body \, dx, the
## bounds and the body as written (a Greek letter's name is \tau).
## >> "integ:" u_se< "Integrals"
## >> @ integ:t_ex< "integral tau:=0..1 | e_xp tau"
## \int_{0}^{1} e_xp tau \, d\tau
m:t_ex< := { @ text -> "\"" c_at (h:l_atex h:r_ead text) c_at "\"" }

### Reading the call

## The call's parts: (variable, low, high, rule, grid, body), each text,
## every rule checked.
h:r_ead := { text ->
  t := t:t_rim text
  _ := (0 < t_ally t) h:r_equire "an empty integral: write integral tau:=a..b | body"
  bar := h:f_irst "|" h:o_utside t
  _ := (0 < bar) h:r_equire "the integral, then | and the body: " c_at t
  head := t:t_rim (bar - 1) t_ake t
  body := t:t_rim bar d_rop t
  _ := (0 < t_ally body) h:r_equire "an empty body after |: " c_at t
  _ := ("integral " t:p_refix? head) h:r_equire "an integral starts with the word integral: " c_at head
  rest := t:t_rim 8 d_rop head
  at := h:f_irst ":=" h:o_utside rest
  _ := (0 < at) h:r_equire "the variable and its bounds, tau:=a..b, not " c_at rest
  var := t:t_rim (at - 1) t_ake rest
  _ := (h:n_ame? var) h:r_equire "the variable is a lowercase name: " c_at var
  after := t:t_rim (at + 1) d_rop rest
  by := h:f_irst " by " h:o_utside after
  range := t:t_rim by h:u_pTo after
  opt := t:t_rim (by, 4) h:p_ast after
  dots := h:f_irst ".." h:o_utside range
  _ := (0 < dots) h:r_equire "the bounds are low..high: " c_at range
  low := t:t_rim (dots - 1) t_ake range
  high := t:t_rim (dots + 1) d_rop range
  _ := ((0 < t_ally low) & 0 < t_ally high) h:r_equire "a bound is missing: " c_at range
  _ := (n_ot (h:i_nfinite? low) | h:i_nfinite? high) h:r_equire "an improper integral (a bound of inf): write a truncation, 0..20 say, and show the tail is small, or change variables so the bounds are finite: " c_at range
  (rule, n) := h:o_ption opt
  (var, h:f_loat low, h:f_loat high, rule, n, body)
}

## The rule and the grid from the text after "by" ("" for none, the
## default trapezoid 64): exactly the two words, a rule the library has,
## a whole number of steps, even for simpson.
h:o_ption := { opt ->
  0 = t_ally opt ? ("trapezoid", "64")
  ws := t:w_ords opt
  _ := (2 = t_ally ws) h:r_equire "after by: the rule and the grid, trapezoid 64 or simpson 32, not " c_at opt
  rule := d_isclose f_irst ws
  n := d_isclose 2 s_elect ws
  _ := ((rule m_atch "trapezoid") | rule m_atch "simpson") h:r_equire "the rule is trapezoid or simpson, not " c_at rule
  _ := ((0 < t_ally n) & '& r_/ n m_ember? []D) h:r_equire "the grid is a whole number of steps: " c_at n
  k := f_irst f_loor n_umbers n
  _ := (0 < k) h:r_equire "the grid needs at least one step: " c_at n
  _ := (n_ot (rule m_atch "simpson") & 1 = k m_od 2) h:r_equire "simpson needs an even number of steps, not " c_at n
  (rule, n)
}

## Whether a bound is written infinite (inf, -inf, infinity, oo).
h:i_nfinite? := { b -> '| r_/ '{ w -> (d_isclose w) m_atch b } e_ach t:w_ords "inf -inf +inf infinity -infinity oo -oo" }

## A bound as Float code: a whole-number literal gets f_loat, any other
## expression stands as written.
h:f_loat := { b ->
  '& r_/ b m_ember? []D c_at "-" ? "f_loat " c_at b
  b
}

### Writing the code

## The expansion: the bounds, the step h, the variable bound to the
## grid (n + 1 points), the rule's weights, and h times the weighted
## sum of the body over the grid.
h:w_rite := { (var, low, high, rule, n, body) ->
  a := []G_ENSYM "a"
  b := []G_ENSYM "b"
  h := []G_ENSYM "h"
  w := []G_ENSYM "w"
  k := f_irst f_loor n_umbers n
  "{ @ ->\n  " c_at a c_at " := " c_at low c_at "\n  " c_at b c_at " := " c_at high c_at "\n  " c_at h c_at " := (" c_at b c_at " - " c_at a c_at ") / " c_at n c_at ".0\n  " c_at var c_at " := " c_at a c_at " + " c_at h c_at " * f_loat o_ffsets " c_at (f_ormat k + 1) c_at "\n  " c_at w c_at " := " c_at (rule h:w_eights k) c_at "\n  " c_at h c_at " * '+ r_/ " c_at w c_at " * " c_at body c_at "\n} @"
}

## The rule's weights over k steps (k + 1 points), as code: trapezoid
## 1/2, 1, ..., 1, 1/2; simpson (1, 4, 2, 4, ..., 4, 1) / 3.
h:w_eights := { rule k ->
  rule m_atch "simpson" ? "(1.0 c_at (" c_at (f_ormat k - 1) c_at " r_eshape 4.0 2.0) c_at 1.0) / 3.0"
  "0.5 c_at (" c_at (f_ormat k - 1) c_at " r_eshape 1.0) c_at 0.5"
}

### The same call as LaTeX

## \int_{a}^{b} body \, dvar, the parts as written; a Greek letter's
## name (tau, theta, ...) becomes its command.
h:l_atex := { (var, low, high, rule, n, body) -> "\\\\int_{" c_at (h:p_lain low) c_at "}^{" c_at (h:p_lain high) c_at "} " c_at body c_at " \\\\, d" c_at h:g_reek var }

## A bound without the f_loat the reader added to a literal.
h:p_lain := { b ->
  "f_loat " t:p_refix? b ? 7 d_rop b
  b
}

## A Greek letter's name as its LaTeX command; any other name as is.
h:g_reek := { v ->
  '| r_/ '{ w -> (d_isclose w) m_atch v } e_ach t:w_ords greek ? "\\\\" c_at v
  v
}
greek := "alpha beta gamma delta epsilon theta lambda mu nu xi pi rho sigma tau phi chi psi omega"

### Text helpers

## Nothing when ok holds; else the call is refused with message, at
## its text (the right side).
h:r_equire := { ok message ->
  ok ? ""
  "bad-integral right" []R_EJECT message
}

## Whether v is a lowercase name: a lowercase letter, then letters or digits.
h:n_ame? := { v ->
  0 = t_ally v ? 0 = 1
  ((f_irst v) m_ember? "abcdefghijklmnopqrstuvwxyz") & '& r_/ v m_ember? "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
}

## 1 at each character of s inside a string literal (its quotes included).
h:q_uoted := { s -> ('+ s_\ 0 + s m_ember? "\"") m_od 2 }

## The positions in s where sep starts outside brackets, braces,
## parentheses and strings.
h:o_utside := { sep s ->
  q := h:q_uoted s
  d := '+ s_\ ((0 + s m_ember? "([{") - 0 + s m_ember? ")]}") * 1 - q
  ps := sep t:f_ind s
  (((ps s_elect d) = 0) & 0 = ps s_elect q) r_eplicate ps
}

## The first of the positions ps, or 0 for none.
h:f_irst := { ps ->
  0 = t_ally ps ? 0
  f_irst ps
}

## s before position k (all of s when k is 0).
h:u_pTo := { k s ->
  0 = k ? s
  (k - 1) t_ake s
}

## s after a separator of length m at position k ("" when k is 0).
h:p_ast := { (k, m) s ->
  0 = k ? ""
  ((k + m) - 1) d_rop s
}

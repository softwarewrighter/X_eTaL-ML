#!/usr/bin/env xetal
# NN: properties that must hold, one "ok:" line each (a "FAIL:" line
# fails the tests).
"nn:" u_se< "NN"
u:c_heck := { name ok -> ok ? "ok: " c_at name
  "FAIL: " c_at name }
u:a_ll := { b -> '& r_/ r_avel b }
m := 3 4 r_eshape 0.5 -1.25 2.0 0.0 3.5 -2.0 1.0 0.25 -0.75 4.0
p := nn:s_oftmax m
"softmax rows sum to 1" u:c_heck u:a_ll (1.0 + 0.0 * '+ r_/_2 p) e_q~ '+ r_/_2 p
"softmax is positive" u:c_heck u:a_ll p > 0.0
"softmax ignores a shift" u:c_heck u:a_ll p e_q~ nn:s_oftmax m + 100.0
"log-softmax is log of softmax" u:c_heck u:a_ll (l_og p) e_q~ nn:l_ogSoftmax m
"softmax of a vector is one row" u:c_heck u:a_ll (r_avel 1 t_ake p) e_q~ nn:s_oftmax r_avel 1 t_ake m
"softmax works along the last axis" u:c_heck u:a_ll (r_avel nn:s_oftmax 2 3 4 r_eshape m) e_q~ r_avel nn:s_oftmax 6 4 r_eshape m
"sigmoid(-x) = 1 - sigmoid(x)" u:c_heck u:a_ll (nn:s_igmoid n_eg r_avel m) e_q~ 1.0 - nn:s_igmoid r_avel m
"tanh is odd" u:c_heck u:a_ll (nn:t_anh n_eg r_avel m) e_q~ n_eg nn:t_anh r_avel m
"relu is leaky with slope 0" u:c_heck u:a_ll (nn:r_elu m) = 0.0 nn:l_eaky m
"argmax of one-hot is the label" u:c_heck u:a_ll 3 1 4 2 = nn:a_rgmax 4 nn:o_neHot 3 1 4 2
"argmax takes the first of a tie" u:c_heck 2 = nn:a_rgmax 0.0 5.0 5.0
"argmax picks softmax's largest" u:c_heck u:a_ll (nn:a_rgmax m) = nn:a_rgmax p
"dense is x W + b" u:c_heck u:a_ll ((2 2 r_eshape 1.0 2.0 3.0 4.0) nn:d_ense 3 2 r_eshape 1.0 0.0 0.0 1.0 10.0 20.0) = 2 2 r_eshape 11.0 22.0 13.0 24.0
"cross-entropy of a perfect guess is 0" u:c_heck 0.0 e_q~ (3 nn:o_neHot 1 2) nn:c_rossEntropy 3 nn:o_neHot 1 2
"accuracy counts argmax hits" u:c_heck 0.5 e_q~ 1 2 nn:a_ccuracy 2 2 r_eshape 0.9 0.1 0.8 0.2
"mse of equal arrays is 0" u:c_heck 0.0 e_q~ m nn:m_se m

#!/usr/bin/env xetal
# Flow: an equation stage must use the previous value (it) or a name
# the pipeline bound, inside its strings or out; one of the caller's
# names only is not a stage.
"e:" u_se< "Equations"
"flow:" u_se< "Flow"
v := 1.0 2.0 3.0
@ flow:p_ipe< c#"v |> "y[i] | 3" e:e_q< "2 * v[i]""#

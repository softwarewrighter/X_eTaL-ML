# The CNN's convolution: nine shifted copies of a 28 x 28 picture as
# 9 x 676, times 8 x 9 filters, ten times.
x := (28 c_at 28) r_eshape 0.0 0.5 1.0 0.25
k := (8 c_at 9) r_eshape 0.3 -0.2 0.1
u:c_onv := { x -> k '+ '* i_nner (9 c_at 676) r_eshape 1 d_rop_4 -1 d_rop_4 1 d_rop_3 -1 d_rop_3 -1 0 1 o_-_2 -1 0 1 o_-_2 x }
'+ r_/ '{ i -> '+ r_/ r_avel u:c_onv x } e_ach r_ange 10
